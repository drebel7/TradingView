alertcondition(univOk and (f_gate(aiMtc3) and mtc3EffOk), title = 'ai-mtc3', message = 'ai-mtc3')
alertcondition(univOk and (f_gate(aiRagPb) and ragpbEffOk), title = 'ai-ragpb', message = 'ai-ragpb')
alertcondition(univOk and (f_gate(aiWonHp) and wonhpEffOk), title = 'ai-wonhp', message = 'ai-wonhp')
