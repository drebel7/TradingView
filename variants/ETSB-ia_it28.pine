plotshape(f_gate(aiObvDiv) and showRow(iShowOnlyGoodSigs, obvdivEffOk, iShowAiObvDiv), title = 'ai-obvdiv', location = location.belowbar, color = obvdivSigColor, style = shape.triangleup, text = 'ai-obvdiv', textcolor = obvdivSigColor)
plotshape(f_gate(aiMtsb) and showRow(iShowOnlyGoodSigs, mtsbEffOk, iShowAiMtsb), title = 'ai-mtsb', location = location.belowbar, color = mtsbSigColor, style = shape.triangleup, text = 'ai-mtsb', textcolor = mtsbSigColor)
