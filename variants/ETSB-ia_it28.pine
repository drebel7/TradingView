plotshape(f_gate(aiRmv3) and showRow(iShowOnlyGoodSigs, rmv3EffOk, iShowAiRmv3), title = 'ai-rmv3', location = location.belowbar, color = rmvSigColor, style = shape.triangleup, text = 'ai-rmv3', textcolor = rmvSigColor)
plotshape(f_gate(aiEtc1) and showRow(iShowOnlyGoodSigs, etc1EffOk, iShowAiEtc1), title = 'ai-etc1', location = location.belowbar, color = etcSigColor, style = shape.triangleup, text = 'ai-etc1', textcolor = etcSigColor)
