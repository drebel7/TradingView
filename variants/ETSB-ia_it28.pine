plotshape(f_gate(aiMtc3) and showRow(iShowOnlyGoodSigs, mtc3EffOk, iShowAiMtc3), title = 'ai-mtc3', location = location.belowbar, color = mtsbSigColor, style = shape.triangleup, text = 'ai-mtc3', textcolor = mtsbSigColor)
plotshape(f_gate(aiRagPb) and showRow(iShowOnlyGoodSigs, ragpbEffOk, iShowAiRagPb), title = 'ai-ragpb', location = location.belowbar, color = ragpbSigColor, style = shape.triangleup, text = 'ai-ragpb', textcolor = ragpbSigColor)
