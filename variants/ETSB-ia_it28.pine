[epqSuccRate, epqSuccCount, epqSigCount, epqAvgReturn, epqSuccRateOk, epqSuccRateStr, epqWinRate, epqWinCount, epqAvgR, epqMedR, epqStdR, epqPf, epqWilsonLb, epqAvgMfe, epqAvgMae, epqMaxDd, epqMaxLossStreak, epqScore, epqQualityOk, epqSumWinR, epqSumLossR] = dreperf.signalQualityFull(f_gate(aiEpq), sl, true, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)

et3EffOk = iUseQualityGate ? et3QualityOk : et3SuccRateOk
et4EffOk = iUseQualityGate ? et4QualityOk : et4SuccRateOk
et1yhEffOk = iUseQualityGate ? et1yhQualityOk : et1yhSuccRateOk
rmv1EffOk = iUseQualityGate ? rmv1QualityOk : rmv1SuccRateOk
rmv2EffOk = iUseQualityGate ? rmv2QualityOk : rmv2SuccRateOk
rmv3EffOk = iUseQualityGate ? rmv3QualityOk : rmv3SuccRateOk
etc1EffOk = iUseQualityGate ? etc1QualityOk : etc1SuccRateOk
etc2EffOk = iUseQualityGate ? etc2QualityOk : etc2SuccRateOk
etc3EffOk = iUseQualityGate ? etc3QualityOk : etc3SuccRateOk
obvdivEffOk = iUseQualityGate ? obvdivQualityOk : obvdivSuccRateOk
mtsbEffOk = iUseQualityGate ? mtsbQualityOk : mtsbSuccRateOk
mtc1EffOk = iUseQualityGate ? mtc1QualityOk : mtc1SuccRateOk
mtc2EffOk = iUseQualityGate ? mtc2QualityOk : mtc2SuccRateOk
mtc3EffOk = iUseQualityGate ? mtc3QualityOk : mtc3SuccRateOk
ragpbEffOk = iUseQualityGate ? ragpbQualityOk : ragpbSuccRateOk
wonhpEffOk = iUseQualityGate ? wonhpQualityOk : wonhpSuccRateOk
wonturnEffOk = iUseQualityGate ? wonturnQualityOk : wonturnSuccRateOk
vwaptagEffOk = iUseQualityGate ? vwaptagQualityOk : vwaptagSuccRateOk
caplowEffOk = iUseQualityGate ? caplowQualityOk : caplowSuccRateOk
flatbEffOk = iUseQualityGate ? flatbQualityOk : flatbSuccRateOk
vipEffOk = iUseQualityGate ? vipQualityOk : vipSuccRateOk
vcp2EffOk = iUseQualityGate ? vcp2QualityOk : vcp2SuccRateOk
vcp2cEffOk = iUseQualityGate ? vcp2cQualityOk : vcp2cSuccRateOk
htfEffOk = iUseQualityGate ? htfQualityOk : htfSuccRateOk
htfTightEffOk = iUseQualityGate ? htfTightQualityOk : htfTightSuccRateOk
epuEffOk = iUseQualityGate ? epuQualityOk : epuSuccRateOk
epqEffOk = iUseQualityGate ? epqQualityOk : epqSuccRateOk
mtsbqEffOk = iUseQualityGate ? mtsbqQualityOk : mtsbqSuccRateOk
mtc3qEffOk = iUseQualityGate ? mtc3qQualityOk : mtc3qSuccRateOk
et4qEffOk = iUseQualityGate ? et4qQualityOk : et4qSuccRateOk
obvqEffOk = iUseQualityGate ? obvqQualityOk : obvqSuccRateOk
mtsbv2aEffOk = iUseQualityGate ? mtsbv2aQualityOk : mtsbv2aSuccRateOk
mtsbv2bEffOk = iUseQualityGate ? mtsbv2bQualityOk : mtsbv2bSuccRateOk
mtsbv2cEffOk = iUseQualityGate ? mtsbv2cQualityOk : mtsbv2cSuccRateOk
mtsbv2dEffOk = iUseQualityGate ? mtsbv2dQualityOk : mtsbv2dSuccRateOk
mtsbv2eEffOk = iUseQualityGate ? mtsbv2eQualityOk : mtsbv2eSuccRateOk

//gated signal aggregate + ai-p1d (opening-range breakout the day after any gated signal)
anyGatedSig = (f_gate(aiEt3sb) and et3EffOk) or (f_gate(aiEt4sb) and et4EffOk) or (f_gate(aiEt1yh) and et1yhEffOk) or (f_gate(aiRmv1) and rmv1EffOk) or (f_gate(aiRmv2) and rmv2EffOk) or (f_gate(aiRmv3) and rmv3EffOk) or (f_gate(aiEtc1) and etc1EffOk) or (f_gate(aiEtc2) and etc2EffOk) or (f_gate(aiEtc3) and etc3EffOk) or (f_gate(aiObvDiv) and obvdivEffOk) or (f_gate(aiMtsb) and mtsbEffOk) or (f_gate(aiMtc1) and mtc1EffOk) or (f_gate(aiMtc2) and mtc2EffOk) or (f_gate(aiMtc3) and mtc3EffOk) or (f_gate(aiRagPb) and ragpbEffOk) or (f_gate(aiWonHp) and wonhpEffOk) or (f_gate(aiWonTurn) and wonturnEffOk) or (f_gate(aiVwapTag) and vwaptagEffOk) or (f_gate(aiCapLow) and caplowEffOk) or (f_gate(aiFlatB) and flatbEffOk) or (f_gate(aiVip) and vipEffOk) or (f_gate(aiVcp2) and vcp2EffOk) or (f_gate(aiVcp2c) and vcp2cEffOk) or (f_gate(aiHtf) and htfEffOk) or (f_gate(aiHtfTight) and htfTightEffOk) or (f_gate(aiEpq) and epqEffOk)
aiP1d = anyGatedSig[1] and orbUp

//plot sig performance
et3SigColor = color.new(color.blue, 0)
et4SigColor = color.new(color.lime, 0)
et1yhSigColor = color.new(color.green, 0)
rmvSigColor = color.new(color.maroon, 0)
etcSigColor = color.new(color.fuchsia, 0)
obvdivSigColor = color.new(color.navy, 0)
mtsbSigColor = color.new(color.gray, 0)
ragpbSigColor = color.new(color.olive, 0)
wonhpSigColor = color.new(color.teal, 0)
wonturnSigColor = color.new(color.purple, 0)
vwaptagSigColor = color.new(color.aqua, 0)
caplowSigColor = color.new(color.orange, 0)
flatbSigColor = color.new(color.black, 0)
vipSigColor = color.new(color.silver, 0)
vcpSigColor = color.new(color.yellow, 0)
vcpCheatSigColor = color.new(color.yellow, 45)
htfSigColor = color.new(color.orange, 0)
epSigColor = color.new(color.red, 0)

//print sig performance table
renderQualityRow(table _tbl, int _row, string _name, color _color, bool _sigOk, bool _showThisSig, float _winRatePct, int _sigCnt, float _avgR, float _pf, float _maxDdR, float _score, float _sumWinR, float _sumLossR) =>
    if showRow(iShowOnlyGoodSigs, _sigOk, _showThisSig)
        table.cell(table_id = _tbl, column = 0, row = _row, text = _name, text_color = _color, text_size = size.small)
        table.cell(table_id = _tbl, column = 1, row = _row, text = str.tostring(_winRatePct, "#.#"), text_size = size.small)
        table.cell(table_id = _tbl, column = 2, row = _row, text = str.tostring(_sigCnt), text_size = size.small)
        table.cell(table_id = _tbl, column = 3, row = _row, text = str.tostring(_avgR, "#.##"), text_size = size.small)
        table.cell(table_id = _tbl, column = 4, row = _row, text = na(_pf) ? "∞" : str.tostring(_pf, "#.##"), text_size = size.small)
        table.cell(table_id = _tbl, column = 5, row = _row, text = str.tostring(_maxDdR, "#.##"), text_size = size.small)
        table.cell(table_id = _tbl, column = 6, row = _row, text = str.tostring(_score, "#.#"), text_size = size.small)
        table.cell(table_id = _tbl, column = 7, row = _row, text = str.tostring(_sumWinR, "#.#"), text_size = size.small)
        table.cell(table_id = _tbl, column = 8, row = _row, text = str.tostring(_sumLossR, "#.#"), text_size = size.small)

if barstate.islast and iShowSigPerfTable
    var tbl = table.new(position = position.top_right, columns = 9, rows = 46)
    table.clear(tbl, 0, 0, 8, 45)
    txtSize = size.small
    table.cell(table_id = tbl, column = 0, row = 0, text = '')
    table.cell(table_id = tbl, column = 0, row = 2, text = "sig", text_size = txtSize)
    table.cell(table_id = tbl, column = 1, row = 2, text = "win%", text_size = txtSize)
    table.cell(table_id = tbl, column = 2, row = 2, text = "N", text_size = txtSize)
    table.cell(table_id = tbl, column = 3, row = 2, text = "avgR", text_size = txtSize)
    table.cell(table_id = tbl, column = 4, row = 2, text = "PF", text_size = txtSize)
    table.cell(table_id = tbl, column = 5, row = 2, text = "maxDD", text_size = txtSize)
    table.cell(table_id = tbl, column = 6, row = 2, text = "score", text_size = txtSize)
    table.cell(table_id = tbl, column = 7, row = 2, text = "winR", text_size = txtSize)
    table.cell(table_id = tbl, column = 8, row = 2, text = "lossR", text_size = txtSize)

    renderQualityRow(tbl, 3, "ai-et3", et3SigColor, et3EffOk, iShowAiEt3, et3WinRate, et3SigCount, et3AvgR, et3Pf, et3MaxDd, et3Score, et3SumWinR, et3SumLossR)
    renderQualityRow(tbl, 4, "ai-et4", et4SigColor, et4EffOk, iShowAiEt4, et4WinRate, et4SigCount, et4AvgR, et4Pf, et4MaxDd, et4Score, et4SumWinR, et4SumLossR)
    renderQualityRow(tbl, 5, "ai-et1yh", et1yhSigColor, et1yhEffOk, iShowAiEt1yh, et1yhWinRate, et1yhSigCount, et1yhAvgR, et1yhPf, et1yhMaxDd, et1yhScore, et1yhSumWinR, et1yhSumLossR)
    renderQualityRow(tbl, 6, "ai-rmv1", rmvSigColor, rmv1EffOk, iShowAiRmv1, rmv1WinRate, rmv1SigCount, rmv1AvgR, rmv1Pf, rmv1MaxDd, rmv1Score, rmv1SumWinR, rmv1SumLossR)
    renderQualityRow(tbl, 7, "ai-rmv2", rmvSigColor, rmv2EffOk, iShowAiRmv2, rmv2WinRate, rmv2SigCount, rmv2AvgR, rmv2Pf, rmv2MaxDd, rmv2Score, rmv2SumWinR, rmv2SumLossR)
    renderQualityRow(tbl, 8, "ai-rmv3", rmvSigColor, rmv3EffOk, iShowAiRmv3, rmv3WinRate, rmv3SigCount, rmv3AvgR, rmv3Pf, rmv3MaxDd, rmv3Score, rmv3SumWinR, rmv3SumLossR)
    renderQualityRow(tbl, 9, "ai-etc1", etcSigColor, etc1EffOk, iShowAiEtc1, etc1WinRate, etc1SigCount, etc1AvgR, etc1Pf, etc1MaxDd, etc1Score, etc1SumWinR, etc1SumLossR)
    renderQualityRow(tbl, 10, "ai-etc2", etcSigColor, etc2EffOk, iShowAiEtc2, etc2WinRate, etc2SigCount, etc2AvgR, etc2Pf, etc2MaxDd, etc2Score, etc2SumWinR, etc2SumLossR)
    renderQualityRow(tbl, 11, "ai-etc3", etcSigColor, etc3EffOk, iShowAiEtc3, etc3WinRate, etc3SigCount, etc3AvgR, etc3Pf, etc3MaxDd, etc3Score, etc3SumWinR, etc3SumLossR)
    renderQualityRow(tbl, 12, "ai-obvdiv", obvdivSigColor, obvdivEffOk, iShowAiObvDiv, obvdivWinRate, obvdivSigCount, obvdivAvgR, obvdivPf, obvdivMaxDd, obvdivScore, obvdivSumWinR, obvdivSumLossR)
    renderQualityRow(tbl, 13, "ai-mtsb", mtsbSigColor, mtsbEffOk, iShowAiMtsb, mtsbWinRate, mtsbSigCount, mtsbAvgR, mtsbPf, mtsbMaxDd, mtsbScore, mtsbSumWinR, mtsbSumLossR)
    renderQualityRow(tbl, 14, "ai-mtsbv2a", mtsbSigColor, mtsbv2aEffOk, iShowAiMtsb, mtsbv2aWinRate, mtsbv2aSigCount, mtsbv2aAvgR, mtsbv2aPf, mtsbv2aMaxDd, mtsbv2aScore, mtsbv2aSumWinR, mtsbv2aSumLossR)
    renderQualityRow(tbl, 15, "ai-mtsbv2b", mtsbSigColor, mtsbv2bEffOk, iShowAiMtsb, mtsbv2bWinRate, mtsbv2bSigCount, mtsbv2bAvgR, mtsbv2bPf, mtsbv2bMaxDd, mtsbv2bScore, mtsbv2bSumWinR, mtsbv2bSumLossR)
    renderQualityRow(tbl, 16, "ai-mtsbv2c", mtsbSigColor, mtsbv2cEffOk, iShowAiMtsb, mtsbv2cWinRate, mtsbv2cSigCount, mtsbv2cAvgR, mtsbv2cPf, mtsbv2cMaxDd, mtsbv2cScore, mtsbv2cSumWinR, mtsbv2cSumLossR)
    renderQualityRow(tbl, 17, "ai-mtsbv2d", mtsbSigColor, mtsbv2dEffOk, iShowAiMtsb, mtsbv2dWinRate, mtsbv2dSigCount, mtsbv2dAvgR, mtsbv2dPf, mtsbv2dMaxDd, mtsbv2dScore, mtsbv2dSumWinR, mtsbv2dSumLossR)
    renderQualityRow(tbl, 18, "ai-mtsbv2e", mtsbSigColor, mtsbv2eEffOk, iShowAiMtsb, mtsbv2eWinRate, mtsbv2eSigCount, mtsbv2eAvgR, mtsbv2ePf, mtsbv2eMaxDd, mtsbv2eScore, mtsbv2eSumWinR, mtsbv2eSumLossR)
    renderQualityRow(tbl, 19, "ai-mtc1", mtsbSigColor, mtc1EffOk, iShowAiMtc1, mtc1WinRate, mtc1SigCount, mtc1AvgR, mtc1Pf, mtc1MaxDd, mtc1Score, mtc1SumWinR, mtc1SumLossR)
    renderQualityRow(tbl, 20, "ai-mtc2", mtsbSigColor, mtc2EffOk, iShowAiMtc2, mtc2WinRate, mtc2SigCount, mtc2AvgR, mtc2Pf, mtc2MaxDd, mtc2Score, mtc2SumWinR, mtc2SumLossR)
    renderQualityRow(tbl, 21, "ai-mtc3", mtsbSigColor, mtc3EffOk, iShowAiMtc3, mtc3WinRate, mtc3SigCount, mtc3AvgR, mtc3Pf, mtc3MaxDd, mtc3Score, mtc3SumWinR, mtc3SumLossR)
    renderQualityRow(tbl, 22, "ai-ragpb", ragpbSigColor, ragpbEffOk, iShowAiRagPb, ragpbWinRate, ragpbSigCount, ragpbAvgR, ragpbPf, ragpbMaxDd, ragpbScore, ragpbSumWinR, ragpbSumLossR)
    renderQualityRow(tbl, 23, "ai-wonhp", wonhpSigColor, wonhpEffOk, iShowAiWonHp, wonhpWinRate, wonhpSigCount, wonhpAvgR, wonhpPf, wonhpMaxDd, wonhpScore, wonhpSumWinR, wonhpSumLossR)
    renderQualityRow(tbl, 24, "ai-wonturn", wonturnSigColor, wonturnEffOk, iShowAiWonTurn, wonturnWinRate, wonturnSigCount, wonturnAvgR, wonturnPf, wonturnMaxDd, wonturnScore, wonturnSumWinR, wonturnSumLossR)
    renderQualityRow(tbl, 25, "ai-vwaptag", vwaptagSigColor, vwaptagEffOk, iShowAiVwapTag, vwaptagWinRate, vwaptagSigCount, vwaptagAvgR, vwaptagPf, vwaptagMaxDd, vwaptagScore, vwaptagSumWinR, vwaptagSumLossR)
    renderQualityRow(tbl, 26, "ai-caplow", caplowSigColor, caplowEffOk, iShowAiCapLow, caplowWinRate, caplowSigCount, caplowAvgR, caplowPf, caplowMaxDd, caplowScore, caplowSumWinR, caplowSumLossR)
    renderQualityRow(tbl, 27, "ai-flatb", flatbSigColor, flatbEffOk, iShowAiFlatB, flatbWinRate, flatbSigCount, flatbAvgR, flatbPf, flatbMaxDd, flatbScore, flatbSumWinR, flatbSumLossR)
    renderQualityRow(tbl, 28, "ai-vip", vipSigColor, vipEffOk, iShowAiVip, vipWinRate, vipSigCount, vipAvgR, vipPf, vipMaxDd, vipScore, vipSumWinR, vipSumLossR)
    renderQualityRow(tbl, 29, "ai-vcp2", vcpSigColor, vcp2EffOk, iShowAiVcp2, vcp2WinRate, vcp2SigCount, vcp2AvgR, vcp2Pf, vcp2MaxDd, vcp2Score, vcp2SumWinR, vcp2SumLossR)
    renderQualityRow(tbl, 30, "ai-vcp2c", vcpCheatSigColor, vcp2cEffOk, iShowAiVcp2c, vcp2cWinRate, vcp2cSigCount, vcp2cAvgR, vcp2cPf, vcp2cMaxDd, vcp2cScore, vcp2cSumWinR, vcp2cSumLossR)
    renderQualityRow(tbl, 31, "ai-htf", htfSigColor, htfEffOk, iShowAiHtf, htfWinRate, htfSigCount, htfAvgR, htfPf, htfMaxDd, htfScore, htfSumWinR, htfSumLossR)
