    renderQualityRow(tbl, 36, "ai-mtc3q", mtsbSigColor, mtc3qEffOk, iShowAiMtc3, mtc3qWinRate, mtc3qSigCount, mtc3qAvgR, mtc3qPf, mtc3qMaxDd, mtc3qScore, mtc3qSumWinR, mtc3qSumLossR)
    renderQualityRow(tbl, 37, "ai-et4q", et4SigColor, et4qEffOk, iShowAiEt4, et4qWinRate, et4qSigCount, et4qAvgR, et4qPf, et4qMaxDd, et4qScore, et4qSumWinR, et4qSumLossR)
    renderQualityRow(tbl, 38, "ai-obvq", obvdivSigColor, obvqEffOk, iShowAiObvDiv, obvqWinRate, obvqSigCount, obvqAvgR, obvqPf, obvqMaxDd, obvqScore, obvqSumWinR, obvqSumLossR)

//plot signals on price chart
plotshape(f_gate(aiEt3sb) and showRow(iShowOnlyGoodSigs, et3EffOk, iShowAiEt3), title = 'ai-et3', location = location.belowbar, color = et3SigColor, style = shape.triangleup, text = 'ai-et3', textcolor = et3SigColor)
plotshape(f_gate(aiEt4sb) and showRow(iShowOnlyGoodSigs, et4EffOk, iShowAiEt4), title = 'ai-et4', location = location.belowbar, color = et4SigColor, style = shape.triangleup, text = 'ai-et4', textcolor = et4SigColor)
plotshape(f_gate(aiEt1yh) and showRow(iShowOnlyGoodSigs, et1yhEffOk, iShowAiEt1yh), title = 'ai-et1yh', location = location.belowbar, color = et1yhSigColor, style = shape.triangleup, text = 'ai-et1yh', textcolor = et1yhSigColor)
plotshape(f_gate(aiRmv1) and showRow(iShowOnlyGoodSigs, rmv1EffOk, iShowAiRmv1), title = 'ai-rmv1', location = location.belowbar, color = rmvSigColor, style = shape.triangleup, text = 'ai-rmv1', textcolor = rmvSigColor)
