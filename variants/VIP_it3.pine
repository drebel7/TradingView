[w15, n15, a15, f15, d15, c15, gw15, gl15] = q8(s15, x15, 30)
[w16, n16, a16, f16, d16, c16, gw16, gl16] = q8(s16, x16, 30)
[w17, n17, a17, f17, d17, c17, gw17, gl17] = q8(s17, x17, 30)
[w18, n18, a18, f18, d18, c18, gw18, gl18] = q8(s18, x18, 30)
[w19, n19, a19, f19, d19, c19, gw19, gl19] = q8(s19, x19, 30)
[w20, n20, a20, f20, d20, c20, gw20, gl20] = q8(s20, x20, 30)
[w21, n21, a21, f21, d21, c21, gw21, gl21] = q8(s21, x21, 30)
[w22, n22, a22, f22, d22, c22, gw22, gl22] = q8(s22, x22, 30)
[w23, n23, a23, f23, d23, c23, gw23, gl23] = q8(s23, x23, 30)
[w24, n24, a24, f24, d24, c24, gw24, gl24] = q8(s24, x24, 30)
[w25, n25, a25, f25, d25, c25, gw25, gl25] = q8(s25, x25, 30)
[w26, n26, a26, f26, d26, c26, gw26, gl26] = q8(s26, x26, 30)
