//calc_bars_count = 3024 (12 years of 252 bars/year) - no need for more

//@version=6
indicator("VIP Volume Institutional Push (perf sweep)", overlay = true, calc_bars_count = 12 * 252, max_bars_back = 500)

import drebel/DRELib/39 as drelib
import drebel/DREPerf/27 as dreperf

// ============================================================================================
// DESIGN NOTES - the "vip" signal and its variants
// --------------------------------------------------------------------------------------------
// The original vip (ETSB) is a volume-accumulation cluster:
//   good day  = volume > SMA30(volume) and close >= previous close
//   cluster   = 4 good days in a row, or 5 of the last 6
//   fresh     = no cluster in the previous 10 bars (one event per push)
//   not extended = percentile rank of close over 200 bars <= 50 (accumulation before a breakout)
//   optional  = at least one very-high-volume day (volume > 2 x SMA30) inside the cluster
//
// This sweep keeps the idea and varies its building blocks:
//   clusterMode 0 = original (4/4 or 5/6), 1 = runLen good days inside window
//   dayMode     0 = close >= prev close, 1 = close > open, 2 = close in the upper half of the bar,
//               3 = close > previous high (a stronger accumulation day)
//   volMult     volume multiple of the volume average that defines a "good day"
//   freshBars   minimum distance to the previous cluster
//   pctMax      upper percentile of close over 200 bars (100 = off)
//   trendMode   0 = percentile filter only, 1 = off, 2 = close > SMA200, 3 = SMA50 > SMA200 and
//               close > SMA50, 4 = close > SMA200 but not more than 10% above it
//   confirmMode 0 = none, 1 = close > previous high, 2 = close in the upper 40% of the bar
//   vhv         require one very-high-volume day (volume > 2 x average) in the cluster window
//   stopMode    0 = house (lowest(low,3) / 8% cap), 1 = 5-day low, 2 = structural (2-day low,
//               at least 3% and never more than 8% below the entry)
//
// Outcome model: DREPerf, entry at the close of the signal bar, fixed check window (30 bars
// unless the row says otherwise), success = the stop is not violated inside the window.
// ============================================================================================

iShowTable = input.bool(defval = true, title = 'Show table', display = display.none, group = 'Sig. performance check')
iSigCheckTime = input.int(defval = 30, title = 'Signal check time [candles]', minval = 5, maxval = 200, display = display.none, group = 'Sig. performance check')
iSigStopLossDay = input.int(defval = 2, title = 'Stop loss (day of low)', minval = 0, maxval = 10, display = display.none, group = 'Sig. performance check')
iSigStopLossMaxPct = input.float(defval = 8.0, title = 'Stop loss [pct]', minval = 0.0, maxval = 20.0, step = 0.5, display = display.none, group = 'Sig. performance check')
iMinSigSuccessRate = input.float(defval = 46.0, title = 'Min. sig success rate [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')
iMinSigReturnAdrMultiple = input.float(defval = 1.2, title = 'Min. avg. return by ADR multiple', minval = -1.0, maxval = 5.0, step = 0.05, display = display.none, group = 'Sig. performance check')
iMinSigCount = input.int(defval = 30, title = 'min. signals count', minval = 0, display = display.none, group = 'Sig. performance check')
iMinSigWilsonLb = input.float(defval = 30.0, title = 'min. win-rate lower bound (Wilson) [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')

adrPct = 100.0 * (ta.sma(high / low, 100) - 1)
adrCond = iMinSigReturnAdrMultiple * adrPct
gVolMa = ta.sma(volume, 30)
gVol50Ma = ta.sma(volume, 50)
float slHouse = math.max(ta.lowest(iSigStopLossDay + 1), close * (1.0 - iSigStopLossMaxPct / 100.0))
closeLoc = high > low ? (close - low) / (high - low) : 0.0
pct200 = ta.percentrank(close, 200)
sma200 = ta.sma(close, 200)
sma50 = ta.sma(close, 50)
benchClose = drelib.getDefaultBenchmarkClose()
rsLine = benchClose > 0 ? close / benchClose : na
rsLineStrong = rsLine > ta.sma(rsLine, 100)
generalFilter = drelib.generalFilter(0.2, 0.0, 1.0, 1750.0, 30)

vipCalc(simple int _clusterMode, simple int _runLen, simple int _window, simple int _freshBars, float _pctMax, float _volMult, simple int _dayMode, simple int _trendMode, simple int _confirmMode, simple int _vhv, simple int _stopMode, simple int _checkBars) =>
    bool _good = _dayMode == 0 ? (volume > _volMult * gVolMa and close >= close[1]) : _dayMode == 1 ? (volume > _volMult * gVolMa and close > open) : _dayMode == 2 ? (volume > _volMult * gVolMa and closeLoc >= 0.5) : (volume > _volMult * gVolMa and close > high[1])
    int _cntW = int(math.sum(_good ? 1.0 : 0.0, _window))
    int _cnt4 = int(math.sum(_good ? 1.0 : 0.0, 4))
    int _cnt6 = int(math.sum(_good ? 1.0 : 0.0, 6))
    bool _c44 = _cnt4 == 4
    bool _c56 = _cnt6 >= 5
    bool _cluster = _clusterMode == 0 ? (_c44 or _c56) : _cntW >= _runLen
    float _since44 = nz(ta.barssince(_c44[1]), 50)
    float _since56 = nz(ta.barssince(_c56[1]), 50)
    float _sinceAny = nz(ta.barssince(_cluster[1]), 999)
    bool _fresh = _clusterMode == 0 ? ((_since44 > _freshBars and _c44) or (_since56 > _freshBars and _c56)) : _sinceAny > _freshBars
    bool _pctOk = bar_index < 200 or _pctMax >= 100.0 ? true : pct200 <= _pctMax
    bool _trendOk = _trendMode == 0 ? true : _trendMode == 1 ? true : _trendMode == 2 ? close > sma200 : _trendMode == 3 ? (close > sma50 and sma50 > sma200) : (close > sma200 and close < sma200 * 1.10)
    bool _confirmOk = _confirmMode == 0 ? true : _confirmMode == 1 ? close > high[1] : closeLoc >= 0.60
    bool _vhvOk = _vhv == 0 ? true : math.sum(volume > 2.0 * gVolMa ? 1.0 : 0.0, _window) >= 1
    bool _sig = generalFilter and _cluster and _fresh and _pctOk and _trendOk and _confirmOk and _vhvOk
    float _sl = _stopMode == 0 ? slHouse : _stopMode == 1 ? math.max(ta.lowest(low, 5), close * 0.92) : math.max(math.min(ta.lowest(low, 2), close * 0.97), close * 0.92)
    [_sig, _sl]

// ============================================================================================
// THE 40 ROWS - ITERATION 1
// --------------------------------------------------------------------------------------------
// Row 1 is the original ETSB vip (percentile 50, no very-high-volume requirement, house stop).
// Every other row changes one building block of the cluster, the day definition, the extension
// filter, the trend context, the confirmation or the stop.
// ============================================================================================
//1 vipRef - original vip
[s01, x01] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//2 extension filter off
[s02, x02] = vipCalc(0, 4, 6, 10, 100.0, 1.0, 0, 0, 0, 0, 0, 30)
//3 extension filter <= 30
[s03, x03] = vipCalc(0, 4, 6, 10, 30.0, 1.0, 0, 0, 0, 0, 0, 30)
//4 extension filter <= 70
[s04, x04] = vipCalc(0, 4, 6, 10, 70.0, 1.0, 0, 0, 0, 0, 0, 30)
//5 freshness 5
[s05, x05] = vipCalc(0, 4, 6, 5, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//6 freshness 20
[s06, x06] = vipCalc(0, 4, 6, 20, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//7 no freshness
[s07, x07] = vipCalc(0, 4, 6, 0, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//8 cluster 3 in 3
[s08, x08] = vipCalc(1, 3, 3, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//9 cluster 5 in 5
[s09, x09] = vipCalc(1, 5, 5, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//10 cluster 6 in 8
[s10, x10] = vipCalc(1, 6, 8, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//11 cluster 4 in 5
[s11, x11] = vipCalc(1, 4, 5, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//12 cluster 7 in 10
[s12, x12] = vipCalc(1, 7, 10, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//13 good day volume 1.2x
[s13, x13] = vipCalc(0, 4, 6, 10, 50.0, 1.2, 0, 0, 0, 0, 0, 30)
//14 good day volume 1.5x
[s14, x14] = vipCalc(0, 4, 6, 10, 50.0, 1.5, 0, 0, 0, 0, 0, 30)
//15 good day volume 0.8x
[s15, x15] = vipCalc(0, 4, 6, 10, 50.0, 0.8, 0, 0, 0, 0, 0, 30)
//16 good day = green close
[s16, x16] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 1, 0, 0, 0, 0, 30)
//17 good day = close in upper half
[s17, x17] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 2, 0, 0, 0, 0, 30)
//18 good day = close above previous high
[s18, x18] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 3, 0, 0, 0, 0, 30)
//19 + close > SMA200
[s19, x19] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 2, 0, 0, 0, 30)
//20 + SMA50 > SMA200 and close > SMA50
[s20, x20] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 3, 0, 0, 0, 30)
//21 + close > SMA200 but < 10% above it
[s21, x21] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 4, 0, 0, 0, 30)
//22 + RS line above its SMA100
[s22, x22] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//23 confirmation: close > previous high
[s23, x23] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 1, 0, 0, 30)
//24 confirmation: close in upper 40% of the bar
[s24, x24] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 2, 0, 0, 30)
//25 stop: 5-day low
[s25, x25] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 0, 0, 1, 30)
//26 stop: structural 2-day low (3-8%)
[s26, x26] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 0, 0, 2, 30)
//27 check window 45
[s27, x27] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 45)
//28 check window 60
[s28, x28] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 0, 0, 0, 60)
//29 require one very-high-volume day
[s29, x29] = vipCalc(0, 4, 6, 10, 50.0, 1.0, 0, 0, 0, 1, 0, 30)
//30 pct 30 + freshness 20
[s30, x30] = vipCalc(0, 4, 6, 20, 30.0, 1.0, 0, 0, 0, 0, 0, 30)
//31 cluster 5/5 + pct 30
[s31, x31] = vipCalc(1, 5, 5, 10, 30.0, 1.0, 0, 0, 0, 0, 0, 30)
//32 cluster 5/5 + close > SMA200
[s32, x32] = vipCalc(1, 5, 5, 10, 50.0, 1.0, 0, 2, 0, 0, 0, 30)
//33 pct 30 + close > SMA200
[s33, x33] = vipCalc(0, 4, 6, 10, 30.0, 1.0, 0, 2, 0, 0, 0, 30)
//34 volume 1.2x + pct 30
[s34, x34] = vipCalc(0, 4, 6, 10, 30.0, 1.2, 0, 0, 0, 0, 0, 30)
//35 green close + pct 30
[s35, x35] = vipCalc(0, 4, 6, 10, 30.0, 1.0, 1, 0, 0, 0, 0, 30)
//36 cluster 5/5 + freshness 20
[s36, x36] = vipCalc(1, 5, 5, 20, 50.0, 1.0, 0, 0, 0, 0, 0, 30)
//37 pct 30 + confirmation close > previous high
[s37, x37] = vipCalc(0, 4, 6, 10, 30.0, 1.0, 0, 0, 1, 0, 0, 30)
//38 close > SMA200 + volume 1.2x
[s38, x38] = vipCalc(0, 4, 6, 10, 50.0, 1.2, 0, 2, 0, 0, 0, 30)
//39 cluster 4/5 + pct 30 + volume 1.2x
[s39, x39] = vipCalc(1, 4, 5, 10, 30.0, 1.2, 0, 0, 0, 0, 0, 30)
//40 cluster 4/5 + pct 30 + close > SMA200
[s40, x40] = vipCalc(1, 4, 5, 10, 30.0, 1.0, 0, 2, 0, 0, 0, 30)

//reference: RS line filter is applied outside the factory (row 22 is a placeholder for the same params)
vipRsLine = s22 and rsLineStrong
s22b = vipRsLine
x22b = x22

// ============================================================================================
// SIGNAL QUALITY (DREPerf)
// ============================================================================================
q8(bool _sig, float _sl, simple int _checkBars) =>
    [sr, scnt, n, ar, sro, srs, wr, wc, avgr, medr, stdr, pf, wlb, mfe, mae, dd, mls, score, qok, swr, slr] = dreperf.signalQualityFull(_sig, _sl, true, iMinSigSuccessRate, adrCond, _checkBars, iMinSigCount, iMinSigWilsonLb)
    [wr, n, avgr, pf, dd, score, swr, slr]

[w01, n01, a01, f01, d01, c01, gw01, gl01] = q8(s01, x01, 30)
[w02, n02, a02, f02, d02, c02, gw02, gl02] = q8(s02, x02, 30)
[w03, n03, a03, f03, d03, c03, gw03, gl03] = q8(s03, x03, 30)
[w04, n04, a04, f04, d04, c04, gw04, gl04] = q8(s04, x04, 30)
[w05, n05, a05, f05, d05, c05, gw05, gl05] = q8(s05, x05, 30)
[w06, n06, a06, f06, d06, c06, gw06, gl06] = q8(s06, x06, 30)
[w07, n07, a07, f07, d07, c07, gw07, gl07] = q8(s07, x07, 30)
[w08, n08, a08, f08, d08, c08, gw08, gl08] = q8(s08, x08, 30)
[w09, n09, a09, f09, d09, c09, gw09, gl09] = q8(s09, x09, 30)
[w10, n10, a10, f10, d10, c10, gw10, gl10] = q8(s10, x10, 30)
[w11, n11, a11, f11, d11, c11, gw11, gl11] = q8(s11, x11, 30)
[w12, n12, a12, f12, d12, c12, gw12, gl12] = q8(s12, x12, 30)
[w13, n13, a13, f13, d13, c13, gw13, gl13] = q8(s13, x13, 30)
[w14, n14, a14, f14, d14, c14, gw14, gl14] = q8(s14, x14, 30)
[w15, n15, a15, f15, d15, c15, gw15, gl15] = q8(s15, x15, 30)
[w16, n16, a16, f16, d16, c16, gw16, gl16] = q8(s16, x16, 30)
[w17, n17, a17, f17, d17, c17, gw17, gl17] = q8(s17, x17, 30)
[w18, n18, a18, f18, d18, c18, gw18, gl18] = q8(s18, x18, 30)
[w19, n19, a19, f19, d19, c19, gw19, gl19] = q8(s19, x19, 30)
[w20, n20, a20, f20, d20, c20, gw20, gl20] = q8(s20, x20, 30)
[w21, n21, a21, f21, d21, c21, gw21, gl21] = q8(s21, x21, 30)
[w22, n22, a22, f22, d22, c22, gw22, gl22] = q8(s22b, x22b, 30)
[w23, n23, a23, f23, d23, c23, gw23, gl23] = q8(s23, x23, 30)
[w24, n24, a24, f24, d24, c24, gw24, gl24] = q8(s24, x24, 30)
[w25, n25, a25, f25, d25, c25, gw25, gl25] = q8(s25, x25, 30)
[w26, n26, a26, f26, d26, c26, gw26, gl26] = q8(s26, x26, 30)
[w27, n27, a27, f27, d27, c27, gw27, gl27] = q8(s27, x27, 45)
[w28, n28, a28, f28, d28, c28, gw28, gl28] = q8(s28, x28, 60)
[w29, n29, a29, f29, d29, c29, gw29, gl29] = q8(s29, x29, 30)
