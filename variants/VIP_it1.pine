// ============================================================================================
// PERFORMANCE TABLE (schema consumed by scripts/tv_table_scraper.py)
// ============================================================================================
renderRow(table _tbl, int _row, string _name, float _winRatePct, int _sigCnt, float _avgR, float _pf, float _maxDdR, float _score, float _sumWinR, float _sumLossR) =>
    table.cell(table_id = _tbl, column = 0, row = _row, text = _name, text_size = size.small)
    table.cell(table_id = _tbl, column = 1, row = _row, text = str.tostring(_winRatePct, "#.#"), text_size = size.small)
    table.cell(table_id = _tbl, column = 2, row = _row, text = str.tostring(_sigCnt), text_size = size.small)
    table.cell(table_id = _tbl, column = 3, row = _row, text = str.tostring(_avgR, "#.##"), text_size = size.small)
    table.cell(table_id = _tbl, column = 4, row = _row, text = na(_pf) ? "∞" : str.tostring(_pf, "#.##"), text_size = size.small)
    table.cell(table_id = _tbl, column = 5, row = _row, text = str.tostring(_maxDdR, "#.##"), text_size = size.small)
    table.cell(table_id = _tbl, column = 6, row = _row, text = str.tostring(_score, "#.#"), text_size = size.small)
    table.cell(table_id = _tbl, column = 7, row = _row, text = str.tostring(_sumWinR, "#.#"), text_size = size.small)
    table.cell(table_id = _tbl, column = 8, row = _row, text = str.tostring(_sumLossR, "#.#"), text_size = size.small)

if barstate.islast and iShowTable
    var tbl = table.new(position = position.top_right, columns = 9, rows = 44)
    txtSize = size.small
    table.cell(table_id = tbl, column = 0, row = 0, text = '')
    table.cell(table_id = tbl, column = 0, row = 2, text = "sig", text_size = txtSize)
    table.cell(table_id = tbl, column = 1, row = 2, text = "win%", text_size = txtSize)
    table.cell(table_id = tbl, column = 2, row = 2, text = "N", text_size = txtSize)
    table.cell(table_id = tbl, column = 3, row = 2, text = "avgR", text_size = txtSize)
    table.cell(table_id = tbl, column = 4, row = 2, text = "PF", text_size = txtSize)
    table.cell(table_id = tbl, column = 5, row = 2, text = "maxDD", text_size = txtSize)
    table.cell(table_id = tbl, column = 6, row = 2, text = "score", text_size = txtSize)
    table.cell(table_id = tbl, column = 7, row = 2, text = "winR", text_size = txtSize)
    table.cell(table_id = tbl, column = 8, row = 2, text = "lossR", text_size = txtSize)

    renderRow(tbl, 3, "vipRef", w01, n01, a01, f01, d01, c01, gw01, gl01)
    renderRow(tbl, 4, "vipPctOff", w02, n02, a02, f02, d02, c02, gw02, gl02)
    renderRow(tbl, 5, "vipPct30", w03, n03, a03, f03, d03, c03, gw03, gl03)
    renderRow(tbl, 6, "vipPct70", w04, n04, a04, f04, d04, c04, gw04, gl04)
    renderRow(tbl, 7, "vipFresh5", w05, n05, a05, f05, d05, c05, gw05, gl05)
    renderRow(tbl, 8, "vipFresh20", w06, n06, a06, f06, d06, c06, gw06, gl06)
    renderRow(tbl, 9, "vipFresh0", w07, n07, a07, f07, d07, c07, gw07, gl07)
    renderRow(tbl, 10, "vipRun3", w08, n08, a08, f08, d08, c08, gw08, gl08)
    renderRow(tbl, 11, "vipRun5", w09, n09, a09, f09, d09, c09, gw09, gl09)
    renderRow(tbl, 12, "vipRun6of8", w10, n10, a10, f10, d10, c10, gw10, gl10)
    renderRow(tbl, 13, "vipRun4of5", w11, n11, a11, f11, d11, c11, gw11, gl11)
    renderRow(tbl, 14, "vipRun7of10", w12, n12, a12, f12, d12, c12, gw12, gl12)
    renderRow(tbl, 15, "vipVol12", w13, n13, a13, f13, d13, c13, gw13, gl13)
    renderRow(tbl, 16, "vipVol15", w14, n14, a14, f14, d14, c14, gw14, gl14)
    renderRow(tbl, 17, "vipVol08", w15, n15, a15, f15, d15, c15, gw15, gl15)
    renderRow(tbl, 18, "vipDayGreen", w16, n16, a16, f16, d16, c16, gw16, gl16)
    renderRow(tbl, 19, "vipDayUpper", w17, n17, a17, f17, d17, c17, gw17, gl17)
    renderRow(tbl, 20, "vipDayAbovePrevHigh", w18, n18, a18, f18, d18, c18, gw18, gl18)
    renderRow(tbl, 21, "vipTrend200", w19, n19, a19, f19, d19, c19, gw19, gl19)
    renderRow(tbl, 22, "vipTrendStack", w20, n20, a20, f20, d20, c20, gw20, gl20)
    renderRow(tbl, 23, "vipNotExtended", w21, n21, a21, f21, d21, c21, gw21, gl21)
    renderRow(tbl, 24, "vipRsLine", w22, n22, a22, f22, d22, c22, gw22, gl22)
    renderRow(tbl, 25, "vipConfirmHigh", w23, n23, a23, f23, d23, c23, gw23, gl23)
    renderRow(tbl, 26, "vipConfirmCloseLoc", w24, n24, a24, f24, d24, c24, gw24, gl24)
