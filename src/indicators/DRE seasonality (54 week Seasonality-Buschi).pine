n_49y = find_n_periods_ago(49)
n_50y = find_n_periods_ago(50)
n_51y = find_n_periods_ago(51)
n_52y = find_n_periods_ago(52)
n_53y = find_n_periods_ago(53)

close_last54w = (close + close[n_1y] + close[n_2y] + close[n_3y] + close[n_4y] + close[n_5y] + close[n_6y] + close[n_7y] + close[n_8y] + close[n_9y] + close[n_10y] 
 + close[n_11y] + close[n_12y] + close[n_13y] + close[n_14y] + close[n_15y] + close[n_16y] + close[n_17y] + close[n_18y] + close[n_19y]
 + close[n_21y] + close[n_22y] + close[n_23y] + close[n_24y] + close[n_25y] + close[n_26y] + close[n_27y] + close[n_28y] + close[n_29y]
 + close[n_31y] + close[n_32y] + close[n_33y] + close[n_34y] + close[n_35y] + close[n_36y] + close[n_37y] + close[n_38y] + close[n_39y]
 + close[n_41y] + close[n_42y] + close[n_43y] + close[n_44y] + close[n_45y] + close[n_46y] + close[n_47y] + close[n_48y] + close[n_49y]
 + close[n_51y] + close[n_52y] + close[n_53y] ) / 54

plot(is_in_last_period ? close_last54w : na, color=color.new(color.purple, 0), linewidth=2, title='all 12 years back')
