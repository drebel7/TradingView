n_14y = find_n_periods_ago(14)
n_15y = find_n_periods_ago(15)
n_16y = find_n_periods_ago(16)
n_17y = find_n_periods_ago(17)
n_18y = find_n_periods_ago(18)
n_19y = find_n_periods_ago(19)
n_20y = find_n_periods_ago(20)
n_21y = find_n_periods_ago(21)
n_22y = find_n_periods_ago(22)
n_23y = find_n_periods_ago(23)
n_24y = find_n_periods_ago(24)
n_25y = find_n_periods_ago(25)
n_26y = find_n_periods_ago(26)
n_27y = find_n_periods_ago(27)
n_28y = find_n_periods_ago(28)
n_29y = find_n_periods_ago(29)
n_30y = find_n_periods_ago(30)
n_31y = find_n_periods_ago(31)
n_32y = find_n_periods_ago(32)
n_33y = find_n_periods_ago(33)
n_34y = find_n_periods_ago(34)
n_35y = find_n_periods_ago(35)
n_36y = find_n_periods_ago(36)
n_37y = find_n_periods_ago(37)
n_38y = find_n_periods_ago(38)
n_39y = find_n_periods_ago(39)
n_40y = find_n_periods_ago(40)
n_41y = find_n_periods_ago(41)
n_42y = find_n_periods_ago(42)
n_43y = find_n_periods_ago(43)
n_44y = find_n_periods_ago(44)
