plotshape(bullishSLongerStepperSig and showRow(iShowOnlyGoodSigs, bullishSLongerStepperSuccRateOk, iBullishLongerStepper), title = 'bullish s-l.stepper', location = location.belowbar, color = bullishSLongerStepperSigColor, style = shape.triangleup, text = 's-l.stepper', textcolor = bullishSLongerStepperSigColor)
plotshape(bullishObvSig and showRow(iShowOnlyGoodSigs, bullishObvSuccRateOk, iBullishObv), title = 'bullish obv', location = location.belowbar, color = bullishObvSigColor, style = shape.triangleup, text = 'obv', textcolor = bullishObvSigColor)
