    if showRow(iShowOnlyGoodSigs, s17SuccRateOk)
        table.cell(table_id = tbl, column = 0, row = 18, text = "bullishHunter", text_size = txtSize)
        table.cell(table_id = tbl, column = 1, row = 18, text = s17SuccRateStr, text_size = txtSize)
    if showRow(iShowOnlyGoodSigs, s18SuccRateOk)
        table.cell(table_id = tbl, column = 0, row = 19, text = "bearishHunter", text_size = txtSize)
        table.cell(table_id = tbl, column = 1, row = 19, text = s18SuccRateStr, text_size = txtSize)
    if showRow(iShowOnlyGoodSigs, s19SuccRateOk)
        table.cell(table_id = tbl, column = 0, row = 20, text = "WON-bullGO", text_size = txtSize)
        table.cell(table_id = tbl, column = 1, row = 20, text = s19SuccRateStr, text_size = txtSize)
    if showRow(iShowOnlyGoodSigs, s20SuccRateOk)
        table.cell(table_id = tbl, column = 0, row = 21, text = "WON-bearGO", text_size = txtSize)
        table.cell(table_id = tbl, column = 1, row = 21, text = s20SuccRateStr, text_size = txtSize)
    if showRow(iShowOnlyGoodSigs, s21SuccRateOk)
        table.cell(table_id = tbl, column = 0, row = 22, text = "FS-GO-CO", text_size = txtSize)
        table.cell(table_id = tbl, column = 1, row = 22, text = s21SuccRateStr, text_size = txtSize)
