plotshape(longerSig and showRow(iShowOnlyGoodSigs, longerSuccRateOk, iLonger), title = 'longer', location = location.belowbar, color = longerSigColor, style = shape.triangleup, text = 'longer', textcolor = longerSigColor)
plotshape(smallerLongerSig and showRow(iShowOnlyGoodSigs, smallerLongerSuccRateOk, iLonger), title = 's-longer', location = location.belowbar, color = smallerLongerSigColor, style = shape.triangleup, text = 's-longer', textcolor = smallerLongerSigColor)
plotshape(zscoreBullishSig and showRow(iShowOnlyGoodSigs, zscoreBullishSuccRateOk, iBullishZscore), title = 'bubble up', location = location.belowbar, color = zscoreBullishSigColor, style = shape.xcross, text = 'bubble up', textcolor = zscoreBullishSigColor)
plotshape(zscoreBearishSig and showRow(iShowOnlyGoodSigs, zscoreBearishSuccRateOk, iBearishZscore), title = 'bubble dn', location = location.belowbar, color = zscoreBearishSigColor, style = shape.xcross, text = 'bubble dn', textcolor = zscoreBearishSigColor)
plotshape(bullishHunterSig and showRow(iShowOnlyGoodSigs, bullishHunterSuccRateOk, iBullishHunter), title = 'bullish hunter', location = location.belowbar, color = bullishHunterSigColor, style = shape.triangleup, text = 'hunter', textcolor = bullishHunterSigColor)
plotshape(bearishHunterSig and showRow(iShowOnlyGoodSigs, bearishHunterSuccRateOk, iBearishHunter), title = 'bearish hunter', location = location.abovebar, color = bearishHunterSigColor, style = shape.triangledown, text = 'hunter', textcolor = bearishHunterSigColor)
plotshape(bullishStepperSig and not bullishLongerStepperSig and showRow(iShowOnlyGoodSigs, bullishStepperSuccRateOk, iBullishStepper), title = 'bullish stepper', location = location.belowbar, color = bullishStepperSigColor, style = shape.triangleup, text = 'stepper', textcolor = bullishStepperSigColor)
