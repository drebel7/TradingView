//issuing alerts
et3sbSig = et3sb and et3sbEffOk
et3sbSig_p1D = et3sbSig[1] and orb
et4sbSig = et4sb and et4sbEffOk
et4sbSig_p1D = et4sbSig[1] and orb
et1YHsbSig = et1YHsb and et1YHsbEffOk
et1YHsbSig_p1D = et1YHsbSig[1] and orb
bullishRmvSig = (bullishRmv1 and rmv1EffOk) or (bullishRmv2 and rmv2EffOk) or (bullishRmv3 and rmv3EffOk)
bullishRmvSig_p1D = bullishRmvSig[1] and orb
etcsbSig = (etc1sb and etc1sbEffOk) or (etc2sb and etc2sbEffOk) or (etc3sb and etc3sbEffOk)
etcsbSig_p1D = etcsbSig[1] and orb
obvDivSig = obvDiv and obvDivEffOk
obvDivSig_p1D = obvDivSig[1] and orb
mtsbSig = (mtsb and mtsbEffOk) or (mtc1sb and mtc1sbEffOk) or (mtc2sb and mtc2sbEffOk) or (mtc3sb and mtc3sbEffOk)
mtsbSig_p1D = mtsbSig[1] and orb
ragPbSig = ragPb and ragPbEffOk
ragPbSig_p1D = ragPbSig[1] and orb
wonHpSbSig = wonHpSb and wonHpSbEffOk
wonHpSbSig_p1D = wonHpSbSig[1] and orb
wonTurnGoUpSig = wonTurnGoUp and wonTurnGoUpEffOk
wonTurnGoUpSig_p1D = wonTurnGoUpSig[1] and orb
minVwapTAGSig = minVwapTAG and minVwapTAGEffOk
minVwapTAGSig_p1D = minVwapTAGSig[1] and orb
CapLowSig = CapLow and CapLowEffOk
CapLowSig_p1D = CapLowSig[1] and orb
FBSig = fb and FBEffOk
FBSig_p1D = FBSig[1] and orb
vipSig = vip and vipEffOk
vipSig_p1D = vipSig[1] and orb
qulEp2Sig = qulEp2 and qulEp2EffOk
qulEp3Sig = qulEp3 and qulEp3EffOk
qulHtfSig = qulHtf and qulHtfEffOk
qulHtf2Sig = qulHtf2 and qulHtf2EffOk

allGoodSig = et3sbSig or et3sbSig_p1D or et4sbSig or et4sbSig_p1D or et1YHsbSig or et1YHsbSig_p1D or bullishRmvSig or bullishRmvSig_p1D or etcsbSig or etcsbSig_p1D or obvDivSig or obvDivSig_p1D or mtsbSig or mtsbSig_p1D or ragPbSig or ragPbSig_p1D or wonHpSbSig or wonHpSbSig_p1D or wonTurnGoUpSig or wonTurnGoUpSig_p1D or minVwapTAGSig or minVwapTAGSig_p1D or CapLowSig or CapLowSig_p1D or FBSig or FBSig_p1D or vipSig or vipSig_p1D or qulEp2Sig or qulEp3Sig or qulHtfSig or qulHtf2Sig

alertcondition(gFilter and (allGoodSig), title = 'best LONG', message = 'best LONG')

alertcondition(gFilter and (et3sbSig or et3sbSig_p1D), title = 'bullish ET3SB', message = 'ET3SB')
alertcondition(gFilter and (et4sbSig or et4sbSig_p1D), title = 'bullish ET4SB', message = 'ET4SB')
alertcondition(gFilter and (et1YHsbSig or et1YHsbSig_p1D), title = 'bullish ET1YHSB', message = 'ET1YHSB')
alertcondition(gFilter and (bullishRmvSig or bullishRmvSig_p1D), title = 'bullish RMV', message = 'RMV')
alertcondition(gFilter and (etcsbSig or etcsbSig_p1D), title = 'bullish ETCSB', message = 'ETCSB')
alertcondition(gFilter and (obvDivSig or obvDivSig_p1D), title = 'bullish obvDiv', message = 'obvDiv')
alertcondition(gFilter and (mtsbSig or mtsbSig_p1D), title = 'bullish mtsb', message = 'mtsb')
alertcondition(gFilter and (ragPbSig or ragPbSig_p1D), title = 'bullish RunAwayGap-pb', message = 'rag-pb')
alertcondition(gFilter and (wonHpSbSig or wonHpSbSig_p1D), title = "bullish O''Neil inspired: hi-percentile sb", message = 'WON:hp-sb')
alertcondition(gFilter and (wonTurnGoUpSig or wonTurnGoUpSig_p1D), title = "bullish O''Neil inspired: turnaround GO Up", message = 'WON:turUp')
alertcondition(gFilter and (minVwapTAGSig or minVwapTAGSig_p1D), title = "bullish riding vwap TAG", message = 'ridingVwapTAG')
alertcondition(gFilter and sessionCloseToEnd and (CapLowSig or CapLowSig_p1D), title = 'bullish CapLow', message = 'CapLow')
alertcondition(gFilter and (FBSig or FBSig_p1D), title = 'bullish FlatB', message = 'FlatB')
alertcondition(gFilter and (vipSig or vipSig_p1D), title = "bullish VIP", message = 'VIP')
alertcondition(gFilter and qulEp2Sig, title = "bullish Qul:EP2", message = 'Qul:EP2')
alertcondition(gFilter and qulEp3Sig, title = "bullish Qul:EP3", message = 'Qul:EP3')
alertcondition(gFilter and qulHtfSig, title = "bullish Qul:HTF", message = 'Qul:HTF')
alertcondition(gFilter and qulHtf2Sig, title = "bullish Qul:HTF2", message = 'Qul:HTF2')
