// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © drebel

//@version=6
indicator(title = 'DRE When-Sell', overlay = true, calc_bars_count = 12 * 252)

import drebel/DRELib/39 as drelib
import drebel/DREPerf/27 as dreperf

//signals switches
iShowCloseBelowSma1 = input.bool(defval = false, title = 'Show close below sma1', group = 'Signals', inline = 'sma')
iShowCloseBelowSma2 = input.bool(defval = false, title = 'sma2', group = 'Signals', inline = 'sma')
iShowCloseBelowSma3 = input.bool(defval = false, title = 'sma3', group = 'Signals', inline = 'sma')
iShowParabolicTop = input.bool(defval = true, title = 'Show parabolic top', group = 'Signals')
iShowParabolicTipTop = input.bool(defval = true, title = 'Show Parabolic tip-top (by @Braczyy)', group = 'Signals')
iShowParabolicRiseStop = input.bool(defval = true, title = 'Show Parabolic rise LOD break', group = 'Signals')
iShowWONTurnaroundGo = input.bool(defval = true, title = "Show W. O'Neail (WON) turnaround GO", group = "Signals")
iShowCombiSig1 = input.bool(defval = true, title = "Show ParaLodBreak + WON turnaround GO", group = "Signals")
iShowCombiSig2 = input.bool(defval = true, title = "Show ParaLodBreak + sma1", group = "Signals")
iShowCombiSig3 = input.bool(defval = true, title = "Show ParaLodBreak + sma2", group = "Signals")

iSigCheckTime = input.int(defval = 30, title = 'Signal check time [candles]', minval = 5, maxval = 200, display = display.none, group = 'Signals')
iMinSigSuccessRate = input.float(defval = 41.0, title = 'Min. sig success rate pct.', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Signals')
iMinSigReturnAdrMultiple = input.float(defval = 0.8, title = 'Min. avg. return by ADR multiple', minval = -1.0, maxval = 5.0, step = 0.05, display = display.none, group = 'Signals')

//common parameters
iSmaLen1 = input.int(defval = 10, title = 'SMA1 len', minval = 1, display = display.none, group = 'Common parameters')
iSmaLen2 = input.int(defval = 20, title = 'SMA2 len', minval = 1, display = display.none, group = 'Common parameters')
iSmaLen3 = input.int(defval = 50, title = 'SMA3 len', minval = 1, display = display.none, group = 'Common parameters')

//common calculations
sma1 = ta.sma(close, iSmaLen1)
sma2 = ta.sma(close, iSmaLen2)
sma3 = ta.sma(close, iSmaLen3)
sma200 = ta.sma(close, 200)
atr50 = ta.sma(high - low, 50)
volHighest10 = ta.highest(volume, 10)
volMa = ta.sma(volume, 30)
vol50Ma = ta.sma(volume, 50)
atr200 = ta.atr(200)
adrPct = 100.0 * (ta.sma(high / low, 100) - 1)

//candle parameters
candleBody = high != low ? (math.max(open, close) - math.min(open, close)) / (high-low) : 0
candleColor = close > open ? 1 : close < open ? -1 : 0
isMarubozuGreen = candleBody > 0.75 and candleColor == 1

dttTimePct = drelib.dttTimePct()
sessionClosed = dttTimePct >= 1

//Signal: Parabolic tip-top (by @Braczyy)
iParabolicTipTopConditions = input.int(defval = 3, title = 'Min. conditions', minval = 3, maxval = 8, display = display.none, group = 'Signal: Parabolic tip-top')

//parabolic top by @Braczyy (https://x.com/Braczyy/status/1978067812527571223)
move12week = high / ta.lowest(12 * 5)
over200sma = close / sma200
consecutiveDaysUp = ta.barssince(close <= close[1])
rng = (high-low) / close
consecutiveRangeUp = ta.barssince(rng <= rng[1])
consecutiveVolumeUp = ta.barssince(volume <= volume[1])
gain = (close - close[1]) / close[1]
highestGain = ta.highest(gain, 12 * 5)
unfilledGapUp = low > close[1]
consecutiveUnfilledGapUp = ta.barssince(not unfilledGapUp)
gapSize = open - close[1]
highestGapSize = ta.highest(gapSize, 12 * 5)
//parabolicTipTip = move12week >= 10 and over200sma >= 5 and consecutiveDaysUp >= 7 and consecutiveRangeUp >= 3 and consecutiveVolumeUp >= 3 and gain == highestGain and consecutiveUnfilledGapUp >= 6 and gapSize == highestGapSize
parabolicTipTipMandatoryConditions = move12week >= 5 and over200sma >= 2.5
parabolicTipTipOptionalConditionsMet = (move12week >= 10 ? 1 : 0) + (over200sma >= 5 ? 1 : 0) + (consecutiveDaysUp >= 7 ? 1 : 0) + (consecutiveRangeUp >= 3 ? 1 : 0) + (consecutiveVolumeUp >= 3 ? 1 : 0 ) + (gain == highestGain ? 1 : 0) + (consecutiveUnfilledGapUp[1] >= 5 ? 1 : 0) + (gapSize == highestGapSize ? 1 : 0)
orbd = drelib.openingRangeBreakdown(60, true, true)
parabolicTipTopCond = parabolicTipTipMandatoryConditions and parabolicTipTipOptionalConditionsMet >= iParabolicTipTopConditions
parabolicTipTopCond2 = (orbd or close < close[1]) and (parabolicTipTopCond or parabolicTipTopCond[1] or parabolicTipTopCond[2])
parabolicTipTop = parabolicTipTopCond2 and not parabolicTipTopCond2[1]

parabolicTipTop4Cond = parabolicTipTipMandatoryConditions and parabolicTipTipOptionalConditionsMet >= 4
parabolicTipTop4Cond2 = (orbd or close < close[1]) and (parabolicTipTop4Cond or parabolicTipTop4Cond[1] or parabolicTipTop4Cond[2])
parabolic4TipTop = parabolicTipTop4Cond2 and not parabolicTipTop4Cond2[1]

parabolicTipTop5Cond = parabolicTipTipMandatoryConditions and parabolicTipTipOptionalConditionsMet >= 5
parabolicTipTop5Cond2 = (orbd or close < close[1]) and (parabolicTipTop5Cond or parabolicTipTop5Cond[1] or parabolicTipTop5Cond[2])
parabolic5TipTop = parabolicTipTop5Cond2 and not parabolicTipTop5Cond2[1]

parabolicTipTop6Cond = parabolicTipTipMandatoryConditions and parabolicTipTipOptionalConditionsMet >= 6
parabolicTipTop6Cond2 = (orbd or close < close[1]) and (parabolicTipTop6Cond or parabolicTipTop6Cond[1] or parabolicTipTop6Cond[2])
parabolic6TipTop = parabolicTipTop6Cond2 and not parabolicTipTop6Cond2[1]

//Signal: Parabolic rise LOD break
iParabolicRisePercentile = input.int(defval = 97, title = 'Percentile above sma 1/2/3', minval = 0, maxval = 100, display = display.none, group = 'Signal: Parabolic rise LOD break')
iParabolicRiseBigRedCandle = input.float(defval = 2.1, title = 'Min. ATR multiple', minval = 0, maxval = 5.0, step = 0.1, display = display.none, group = 'Signal: Parabolic rise LOD break')
iParabolicRiseVolumeCond = input.bool(defval = true, title = 'Highest volume of last 10 days within last 3 days', display = display.none, group = 'Signal: Parabolic rise LOD break')

//parabolic rise LOD break
aboveSma1PctCond = ta.percentrank(high - sma1, 500) >= iParabolicRisePercentile
aboveSma2PctCond = ta.percentrank(high - sma2, 500) >= iParabolicRisePercentile
aboveSma3PctCond = ta.percentrank(high - sma3, 500) >= iParabolicRisePercentile
volumeCond = iParabolicRiseVolumeCond and (volume == volHighest10 or volume[1] == volHighest10[1] or volume[2] == volHighest10[2]) or not iParabolicRiseVolumeCond

parabolicRiseCond = aboveSma1PctCond and aboveSma2PctCond and aboveSma3PctCond and close > 1.7 * close[100]
veryBigCandle = (high - low) > atr50 * iParabolicRiseBigRedCandle
parabolicRiseLodBreak = (parabolicRiseCond[1] or parabolicRiseCond) and low < low[1] and (veryBigCandle or veryBigCandle[1]) and not isMarubozuGreen
parabolicRiseLodBreakCond = parabolicRiseLodBreak and not parabolicRiseLodBreak[1] and not parabolicRiseLodBreak[2] and not parabolicRiseLodBreak[3] and volumeCond

//Signal: Parabolic top
top1Sig = drelib.sigParabolicTop(volMa, 2, 100, 8, atr200)
top2Sig = drelib.sigParabolicTop(volMa, 3, 100, 8, atr200)
top3Sig = drelib.sigParabolicTop(volMa, 4, 100, 8, atr200)
topSig = top1Sig or top2Sig or top3Sig

//Signal: WON turnaround GO - created to signal general market early turnarounds
iWONTurnaroundExtremeAgo = input.int(defval = 45, title = "max. peak/bottom ago", minval = 20, maxval = 60, step = 5, display = display.none, group = "Signal: WON turnaround GO")
iWONTurnaroundGoDayMinRange = input.float(defval = 0.0, title = "min. day range", minval = 0.0, maxval = 10.0, step = 0.1, display = display.none, group = "Signal: WON turnaround GO", tooltip = "Use 0 for auto calculation based on adr. \nfor adr < 0.017 uses 0.017\nfor adr >= 0.017 uses 0.017 + (adr - 0.017) / 4")
iWONTurnaroundMinGoDays = input.int(defval = 3, title = "min. days", minval = 1, maxval = 10, display = display.none, group = "Signal: WON turnaround GO")

adr = adrPct / 100
turnaroundGoDayMinRange = iWONTurnaroundGoDayMinRange > 0.0 ? iWONTurnaroundGoDayMinRange / 100 : (adr < 0.017 ? 0.017 : 0.017 + (adr - 0.017) / 4)
wonBearGoSig = drelib.sigWONTurnaroundDn(iWONTurnaroundExtremeAgo, iWONTurnaroundMinGoDays, turnaroundGoDayMinRange, sma200, vol50Ma)

//Signal: Close below SMA
belowSma1 = close < sma1
newBelowSma1 = belowSma1 and not belowSma1[1]

belowSma2 = close < sma2
newBelowSma2 = belowSma2 and not belowSma2[1]

belowSma3 = close < sma3
newBelowSma3 = belowSma3 and not belowSma3[1]

//Signal: Combination
iParabolicRiseLodBreak2WonBearGoTimeSpread = input.int(defval = 13, title = "parabolic rise LOD break -> WON Bear GO: time spread", minval = 5, maxval = 20, display = display.none, group = "Signal: Combination")

//time combination of above signals
parabolicRiseLodBreakAgo = ta.barssince(parabolicRiseLodBreakCond)
combiSig1 = wonBearGoSig and parabolicRiseLodBreakAgo < iParabolicRiseLodBreak2WonBearGoTimeSpread
combiSig2 = newBelowSma1 and parabolicRiseLodBreakAgo < iParabolicRiseLodBreak2WonBearGoTimeSpread
combiSig3 = newBelowSma2 and parabolicRiseLodBreakAgo < iParabolicRiseLodBreak2WonBearGoTimeSpread

//signals aggregate
onSessionCloseConditions = sessionClosed and (newBelowSma1 or newBelowSma2 or newBelowSma3 or combiSig1 or combiSig2 or combiSig3)
tipTopAndCombiCond = parabolicTipTop or sessionClosed and (combiSig1 or combiSig2 or combiSig3)
allCond = parabolicTipTop or parabolicRiseLodBreakCond or topSig or onSessionCloseConditions or wonBearGoSig

//check performance
adrCond = iMinSigReturnAdrMultiple * adrPct

iShowSigPerfTable = input.bool(defval = false, title = 'show table', group = 'Sig. performance check')
iShowOnlyGoodSigs = input.bool(defval = false, title = 'show only good sigs.', group = 'Sig. performance check')
iUseQualityGate = input.bool(defval = false, title = 'use extended quality gate', display = display.none, group = 'Sig. performance check')
iMinSigCount = input.int(defval = 30, title = 'min. signals count', minval = 0, display = display.none, group = 'Sig. performance check')
iMinSigWilsonLb = input.float(defval = 30.0, title = 'min. win-rate lower bound (Wilson) [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')

showRow(_iShowOnlyGoodSigs, sigOk) =>
    _iShowOnlyGoodSigs and sigOk or not _iShowOnlyGoodSigs

showRow(_iShowOnlyGoodSigs, sigOk, _showThisSig) =>
    _showThisSig and (_iShowOnlyGoodSigs and sigOk or not _iShowOnlyGoodSigs)

[topSuccRate, topSuccCount, topSigCount, topAvgReturn, topSuccRateOk, topSuccRateStr, topWinRate, topWinCount, topAvgR, topMedR, topStdR, topPf, topWilsonLb, topAvgMfe, topAvgMae, topMaxDd, topMaxLossStreak, topScore, topQualityOk, topSumWinR, topSumLossR] = dreperf.signalQualityFull(topSig, topSig ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[parabolicRiseLodBreakSuccRate, parabolicRiseLodBreakSuccCount, parabolicRiseLodBreakSigCount, parabolicRiseLodBreakAvgReturn, parabolicRiseLodBreakSuccRateOk, parabolicRiseLodBreakSuccRateStr, parabolicRiseLodBreakWinRate, parabolicRiseLodBreakWinCount, parabolicRiseLodBreakAvgR, parabolicRiseLodBreakMedR, parabolicRiseLodBreakStdR, parabolicRiseLodBreakPf, parabolicRiseLodBreakWilsonLb, parabolicRiseLodBreakAvgMfe, parabolicRiseLodBreakAvgMae, parabolicRiseLodBreakMaxDd, parabolicRiseLodBreakMaxLossStreak, parabolicRiseLodBreakScore, parabolicRiseLodBreakQualityOk, parabolicRiseLodBreakSumWinR, parabolicRiseLodBreakSumLossR] = dreperf.signalQualityFull(parabolicRiseLodBreakCond, parabolicRiseLodBreakCond ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[tiptopSuccRate, tiptopSuccCount, tiptopSigCount, tiptopAvgReturn, tiptopSuccRateOk, tiptopSuccRateStr, tiptopWinRate, tiptopWinCount, tiptopAvgR, tiptopMedR, tiptopStdR, tiptopPf, tiptopWilsonLb, tiptopAvgMfe, tiptopAvgMae, tiptopMaxDd, tiptopMaxLossStreak, tiptopScore, tiptopQualityOk, tiptopSumWinR, tiptopSumLossR] = dreperf.signalQualityFull(parabolicTipTop, parabolicTipTop ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[tiptop4SuccRate, tiptop4SuccCount, tiptop4SigCount, tiptop4AvgReturn, tiptop4SuccRateOk, tiptop4SuccRateStr, tiptop4WinRate, tiptop4WinCount, tiptop4AvgR, tiptop4MedR, tiptop4StdR, tiptop4Pf, tiptop4WilsonLb, tiptop4AvgMfe, tiptop4AvgMae, tiptop4MaxDd, tiptop4MaxLossStreak, tiptop4Score, tiptop4QualityOk, tiptop4SumWinR, tiptop4SumLossR] = dreperf.signalQualityFull(parabolic4TipTop, parabolic4TipTop ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[tiptop5SuccRate, tiptop5SuccCount, tiptop5SigCount, tiptop5AvgReturn, tiptop5SuccRateOk, tiptop5SuccRateStr, tiptop5WinRate, tiptop5WinCount, tiptop5AvgR, tiptop5MedR, tiptop5StdR, tiptop5Pf, tiptop5WilsonLb, tiptop5AvgMfe, tiptop5AvgMae, tiptop5MaxDd, tiptop5MaxLossStreak, tiptop5Score, tiptop5QualityOk, tiptop5SumWinR, tiptop5SumLossR] = dreperf.signalQualityFull(parabolic5TipTop, parabolic5TipTop ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[tiptop6SuccRate, tiptop6SuccCount, tiptop6SigCount, tiptop6AvgReturn, tiptop6SuccRateOk, tiptop6SuccRateStr, tiptop6WinRate, tiptop6WinCount, tiptop6AvgR, tiptop6MedR, tiptop6StdR, tiptop6Pf, tiptop6WilsonLb, tiptop6AvgMfe, tiptop6AvgMae, tiptop6MaxDd, tiptop6MaxLossStreak, tiptop6Score, tiptop6QualityOk, tiptop6SumWinR, tiptop6SumLossR] = dreperf.signalQualityFull(parabolic6TipTop, parabolic6TipTop ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[sma1SuccRate, sma1SuccCount, sma1SigCount, sma1AvgReturn, sma1SuccRateOk, sma1SuccRateStr, sma1WinRate, sma1WinCount, sma1AvgR, sma1MedR, sma1StdR, sma1Pf, sma1WilsonLb, sma1AvgMfe, sma1AvgMae, sma1MaxDd, sma1MaxLossStreak, sma1Score, sma1QualityOk, sma1SumWinR, sma1SumLossR] = dreperf.signalQualityFull(belowSma1, belowSma1 ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[sma2SuccRate, sma2SuccCount, sma2SigCount, sma2AvgReturn, sma2SuccRateOk, sma2SuccRateStr, sma2WinRate, sma2WinCount, sma2AvgR, sma2MedR, sma2StdR, sma2Pf, sma2WilsonLb, sma2AvgMfe, sma2AvgMae, sma2MaxDd, sma2MaxLossStreak, sma2Score, sma2QualityOk, sma2SumWinR, sma2SumLossR] = dreperf.signalQualityFull(belowSma2, belowSma2 ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[sma3SuccRate, sma3SuccCount, sma3SigCount, sma3AvgReturn, sma3SuccRateOk, sma3SuccRateStr, sma3WinRate, sma3WinCount, sma3AvgR, sma3MedR, sma3StdR, sma3Pf, sma3WilsonLb, sma3AvgMfe, sma3AvgMae, sma3MaxDd, sma3MaxLossStreak, sma3Score, sma3QualityOk, sma3SumWinR, sma3SumLossR] = dreperf.signalQualityFull(belowSma3, belowSma3 ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[wonGoDnSuccRate, wonGoDnSuccCount, wonGoDnSigCount, wonGoDnAvgReturn, wonGoDnSuccRateOk, wonGoDnSuccRateStr, wonGoDnWinRate, wonGoDnWinCount, wonGoDnAvgR, wonGoDnMedR, wonGoDnStdR, wonGoDnPf, wonGoDnWilsonLb, wonGoDnAvgMfe, wonGoDnAvgMae, wonGoDnMaxDd, wonGoDnMaxLossStreak, wonGoDnScore, wonGoDnQualityOk, wonGoDnSumWinR, wonGoDnSumLossR] = dreperf.signalQualityFull(wonBearGoSig, wonBearGoSig ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[combiSig1SuccRate, combiSig1SuccCount, combiSig1Count, combiSig1AvgReturn, combiSig1SuccRateOk, combiSig1SuccRateStr, combiSig1WinRate, combiSig1WinCount, combiSig1AvgR, combiSig1MedR, combiSig1StdR, combiSig1Pf, combiSig1WilsonLb, combiSig1AvgMfe, combiSig1AvgMae, combiSig1MaxDd, combiSig1MaxLossStreak, combiSig1Score, combiSig1QualityOk, combiSig1SumWinR, combiSig1SumLossR] = dreperf.signalQualityFull(combiSig1, combiSig1 ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[combiSig2SuccRate, combiSig2SuccCount, combiSig2Count, combiSig2AvgReturn, combiSig2SuccRateOk, combiSig2SuccRateStr, combiSig2WinRate, combiSig2WinCount, combiSig2AvgR, combiSig2MedR, combiSig2StdR, combiSig2Pf, combiSig2WilsonLb, combiSig2AvgMfe, combiSig2AvgMae, combiSig2MaxDd, combiSig2MaxLossStreak, combiSig2Score, combiSig2QualityOk, combiSig2SumWinR, combiSig2SumLossR] = dreperf.signalQualityFull(combiSig2, combiSig2 ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
[combiSig3SuccRate, combiSig3SuccCount, combiSig3Count, combiSig3AvgReturn, combiSig3SuccRateOk, combiSig3SuccRateStr, combiSig3WinRate, combiSig3WinCount, combiSig3AvgR, combiSig3MedR, combiSig3StdR, combiSig3Pf, combiSig3WilsonLb, combiSig3AvgMfe, combiSig3AvgMae, combiSig3MaxDd, combiSig3MaxLossStreak, combiSig3Score, combiSig3QualityOk, combiSig3SumWinR, combiSig3SumLossR] = dreperf.signalQualityFull(combiSig3, combiSig3 ? high : na, false, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)

topEffOk = iUseQualityGate ? topQualityOk : topSuccRateOk
parabolicRiseLodBreakEffOk = iUseQualityGate ? parabolicRiseLodBreakQualityOk : parabolicRiseLodBreakSuccRateOk
tiptopEffOk = iUseQualityGate ? tiptopQualityOk : tiptopSuccRateOk
tiptop4EffOk = iUseQualityGate ? tiptop4QualityOk : tiptop4SuccRateOk
tiptop5EffOk = iUseQualityGate ? tiptop5QualityOk : tiptop5SuccRateOk
tiptop6EffOk = iUseQualityGate ? tiptop6QualityOk : tiptop6SuccRateOk
sma1EffOk = iUseQualityGate ? sma1QualityOk : sma1SuccRateOk
sma2EffOk = iUseQualityGate ? sma2QualityOk : sma2SuccRateOk
sma3EffOk = iUseQualityGate ? sma3QualityOk : sma3SuccRateOk
wonGoDnEffOk = iUseQualityGate ? wonGoDnQualityOk : wonGoDnSuccRateOk
combiSig1EffOk = iUseQualityGate ? combiSig1QualityOk : combiSig1SuccRateOk
combiSig2EffOk = iUseQualityGate ? combiSig2QualityOk : combiSig2SuccRateOk
combiSig3EffOk = iUseQualityGate ? combiSig3QualityOk : combiSig3SuccRateOk

//plot sig performance
topSigColor = color.new(color.fuchsia, 0)
parabolicRiseLodBreakSigColor = color.new(color.maroon, 0)
tiptopSigColor = color.new(color.red, 0)
sma1SigColor = color.new(color.orange, 0)
sma2SigColor = color.new(color.red, 0)
sma3SigColor = color.new(color.red, 0)
wonGoDnSigColor = color.new(color.purple, 0)
combiSig1SigColor = color.new(color.red, 0)
combiSig2SigColor = color.new(color.orange, 0)
combiSig3SigColor = color.new(color.red, 0)

//print sig performance table
renderQualityRow(table _tbl, int _row, string _name, color _color, bool _sigOk, bool _showThisSig, string _perfStr, float _winRatePct, int _sigCnt, float _avgR, float _pf, float _maxDdR, float _score, float _sumWinR, float _sumLossR) =>
    if showRow(iShowOnlyGoodSigs, _sigOk, _showThisSig)
        table.cell(table_id = _tbl, column = 0, row = _row, text = _name, text_color = _color, text_size = size.small)
        table.cell(table_id = _tbl, column = 1, row = _row, text = _perfStr, text_size = size.small)
        table.cell(table_id = _tbl, column = 2, row = _row, text = str.tostring(_winRatePct, "#.#"), text_size = size.small)
        table.cell(table_id = _tbl, column = 3, row = _row, text = str.tostring(_sigCnt), text_size = size.small)
        table.cell(table_id = _tbl, column = 4, row = _row, text = str.tostring(_avgR, "#.##"), text_size = size.small)
        table.cell(table_id = _tbl, column = 5, row = _row, text = na(_pf) ? "∞" : str.tostring(_pf, "#.##"), text_size = size.small)
        table.cell(table_id = _tbl, column = 6, row = _row, text = str.tostring(_maxDdR, "#.##"), text_size = size.small)
        table.cell(table_id = _tbl, column = 7, row = _row, text = str.tostring(_score, "#.#"), text_size = size.small)
        table.cell(table_id = _tbl, column = 8, row = _row, text = str.tostring(_sumWinR, "#.#"), text_size = size.small)
        table.cell(table_id = _tbl, column = 9, row = _row, text = str.tostring(_sumLossR, "#.#"), text_size = size.small)

if barstate.islast and iShowSigPerfTable
    var tbl = table.new(position = position.top_right, columns = 10, rows = 15)
    txtSize = size.small
    table.cell(table_id = tbl, column = 0, row = 1, text = "sig", text_size = txtSize)
    table.cell(table_id = tbl, column = 1, row = 1, text = "perf " + str.tostring(iMinSigSuccessRate, "#.# ") + str.tostring(adrCond, "#.#"), text_size = txtSize)
    table.cell(table_id = tbl, column = 2, row = 1, text = "win%", text_size = txtSize)
    table.cell(table_id = tbl, column = 3, row = 1, text = "N", text_size = txtSize)
    table.cell(table_id = tbl, column = 4, row = 1, text = "avgR", text_size = txtSize)
    table.cell(table_id = tbl, column = 5, row = 1, text = "PF", text_size = txtSize)
    table.cell(table_id = tbl, column = 6, row = 1, text = "maxDD", text_size = txtSize)
    table.cell(table_id = tbl, column = 7, row = 1, text = "score", text_size = txtSize)
    table.cell(table_id = tbl, column = 8, row = 1, text = "winR", text_size = txtSize)
    table.cell(table_id = tbl, column = 9, row = 1, text = "lossR", text_size = txtSize)

    renderQualityRow(tbl, 2, "top", topSigColor, topEffOk, true, topSuccRateStr, topWinRate, topSigCount, topAvgR, topPf, topMaxDd, topScore, topSumWinR, topSumLossR)
    renderQualityRow(tbl, 3, "paraRiseLodBreak", parabolicRiseLodBreakSigColor, parabolicRiseLodBreakEffOk, true, parabolicRiseLodBreakSuccRateStr, parabolicRiseLodBreakWinRate, parabolicRiseLodBreakSigCount, parabolicRiseLodBreakAvgR, parabolicRiseLodBreakPf, parabolicRiseLodBreakMaxDd, parabolicRiseLodBreakScore, parabolicRiseLodBreakSumWinR, parabolicRiseLodBreakSumLossR)
    renderQualityRow(tbl, 4, "tip-top", tiptopSigColor, tiptopEffOk, true, tiptopSuccRateStr, tiptopWinRate, tiptopSigCount, tiptopAvgR, tiptopPf, tiptopMaxDd, tiptopScore, tiptopSumWinR, tiptopSumLossR)
    renderQualityRow(tbl, 5, "tip-top4", tiptopSigColor, tiptop4EffOk, true, tiptop4SuccRateStr, tiptop4WinRate, tiptop4SigCount, tiptop4AvgR, tiptop4Pf, tiptop4MaxDd, tiptop4Score, tiptop4SumWinR, tiptop4SumLossR)
    renderQualityRow(tbl, 6, "tip-top5", tiptopSigColor, tiptop5EffOk, true, tiptop5SuccRateStr, tiptop5WinRate, tiptop5SigCount, tiptop5AvgR, tiptop5Pf, tiptop5MaxDd, tiptop5Score, tiptop5SumWinR, tiptop5SumLossR)
    renderQualityRow(tbl, 7, "tip-top6", tiptopSigColor, tiptop6EffOk, true, tiptop6SuccRateStr, tiptop6WinRate, tiptop6SigCount, tiptop6AvgR, tiptop6Pf, tiptop6MaxDd, tiptop6Score, tiptop6SumWinR, tiptop6SumLossR)
    renderQualityRow(tbl, 8, "sma10", sma1SigColor, sma1EffOk, true, sma1SuccRateStr, sma1WinRate, sma1SigCount, sma1AvgR, sma1Pf, sma1MaxDd, sma1Score, sma1SumWinR, sma1SumLossR)
    renderQualityRow(tbl, 9, "sma20", sma2SigColor, sma2EffOk, true, sma2SuccRateStr, sma2WinRate, sma2SigCount, sma2AvgR, sma2Pf, sma2MaxDd, sma2Score, sma2SumWinR, sma2SumLossR)
    renderQualityRow(tbl, 10, "sma50", sma3SigColor, sma3EffOk, true, sma3SuccRateStr, sma3WinRate, sma3SigCount, sma3AvgR, sma3Pf, sma3MaxDd, sma3Score, sma3SumWinR, sma3SumLossR)
    renderQualityRow(tbl, 11, "WON GO dn", wonGoDnSigColor, wonGoDnEffOk, true, wonGoDnSuccRateStr, wonGoDnWinRate, wonGoDnSigCount, wonGoDnAvgR, wonGoDnPf, wonGoDnMaxDd, wonGoDnScore, wonGoDnSumWinR, wonGoDnSumLossR)
    renderQualityRow(tbl, 12, "combi sig1", combiSig1SigColor, combiSig1EffOk, true, combiSig1SuccRateStr, combiSig1WinRate, combiSig1Count, combiSig1AvgR, combiSig1Pf, combiSig1MaxDd, combiSig1Score, combiSig1SumWinR, combiSig1SumLossR)
    renderQualityRow(tbl, 13, "combi sig2", combiSig2SigColor, combiSig2EffOk, true, combiSig2SuccRateStr, combiSig2WinRate, combiSig2Count, combiSig2AvgR, combiSig2Pf, combiSig2MaxDd, combiSig2Score, combiSig2SumWinR, combiSig2SumLossR)
    renderQualityRow(tbl, 14, "combi sig3", combiSig3SigColor, combiSig3EffOk, true, combiSig3SuccRateStr, combiSig3WinRate, combiSig3Count, combiSig3AvgR, combiSig3Pf, combiSig3MaxDd, combiSig3Score, combiSig3SumWinR, combiSig3SumLossR)

//plot signals on price chart
if iShowCloseBelowSma1 and newBelowSma1
    label.new(bar_index, close, tooltip = 'close < sma1', color = color.new(color.orange, 70), style = label.style_circle, size = size.tiny)
//plotshape(iShowCloseBelowSma1 and newBelowSma1, title = 'close below sma1', location = location.absolute, color = color.new(color.red, 0), style = shape.triangledown, text = 'close < sma1', textcolor = color.new(color.red, 0))

if iShowCloseBelowSma2 and newBelowSma2
    label.new(bar_index, close, tooltip = 'close < sma2', color = color.new(color.red, 70), style = label.style_circle, size = size.tiny)
//plotshape(iShowCloseBelowSma2 and newBelowSma2, title = 'close below sma2', location = location.absolute, color = color.new(color.red, 0), style = shape.triangledown, text = 'close < sma2', textcolor = color.new(color.red, 0))

if iShowCloseBelowSma3 and newBelowSma3
    label.new(bar_index, close, tooltip = 'close < sma3', color = color.new(color.red, 70), style = label.style_circle, size = size.tiny)
//plotshape(iShowCloseBelowSma3 and newBelowSma3, title = 'close below sma3', location = location.absolute, color = color.new(color.red, 0), style = shape.triangledown, text = 'close < sma3', textcolor = color.new(color.red, 0))

if iShowParabolicTop and topSig
    label.new(bar_index, open, tooltip = 'top', color = color.new(color.red, 70), style = label.style_triangledown, size = size.tiny)
//plotshape(iShowParabolicTop and topSig ? close : na, title = 'parabolic top', location = location.absolute, color = color.new(color.red, 0), style = shape.triangledown, text = 'top', textcolor = color.new(color.red, 0))

if iShowParabolicRiseStop and parabolicRiseLodBreakCond
    label.new(bar_index, math.min(low[1], open), tooltip = 'parabolic rise lod - break', color = color.new(color.red, 70), style = label.style_diamond, size = size.tiny)
//plotshape(iShowParabolicRiseStop and parabolicRiseLodBreakCond, title = 'parabolic rise lod - break', location = location.absolute, color = color.new(color.red, 0), style = shape.triangledown, text = 'par. rise LOD break', textcolor = color.new(color.red, 0))

if iShowParabolicTipTop and parabolicTipTop
    label.new(bar_index, close[1], tooltip = 'parabolic tip tip', color = color.new(color.red, 35), style = label.style_xcross, size = size.tiny)

if iShowWONTurnaroundGo and wonBearGoSig
    label.new(bar_index, close[1], tooltip = 'WON: turnaround GO down', color = color.new(color.red, 70), style = label.style_flag, size = size.tiny)

if iShowCombiSig1 and combiSig1
    label.new(bar_index, close, tooltip = 'combi sig1', color = color.new(color.red, 35), style = label.style_flag, size = size.tiny)

if iShowCombiSig2 and combiSig2
    label.new(bar_index, close, tooltip = 'combi sig2', color = color.new(color.orange, 35), style = label.style_circle, size = size.tiny)

if iShowCombiSig3 and combiSig3
    label.new(bar_index, close, tooltip = 'combi sig3', color = color.new(color.red, 35), style = label.style_circle, size = size.tiny)

//issuing alerts
alertcondition(newBelowSma1, title = 'close below sma1', message = 'close < sma1')
alertcondition(newBelowSma2, title = 'close below sma2', message = 'close < sma2')
alertcondition(newBelowSma3, title = 'close below sma3', message = 'close < sma3')
alertcondition(topSig, title = 'parabolic top', message = 'top')
alertcondition(parabolicRiseLodBreakCond, title = 'parabolic rise lod - break', message = 'LOD break')
alertcondition(parabolicTipTop, title = 'parabolic tip top', message = 'parabolic tip tip')
alertcondition(wonBearGoSig, title = 'WON: turnaround GO down', message = 'WON: GO down')
alertcondition(combiSig1, title = 'combi sig1 (paraLodBreak + WON turnaround GO)', message = 'combi sig1')
alertcondition(combiSig2, title = 'combi sig2 (paraLodBreak + sma1)', message = 'combi sig2')
alertcondition(combiSig3, title = 'combi sig3 (paraLodBreak + sma2)', message = 'combi sig3')
alertcondition(tipTopAndCombiCond, title = 'when-sell - tipTop and combi', message = 'when-sell - tipTop and combi')
alertcondition(allCond, title = 'when-sell - all sigs', message = 'when-sell')
