// perf_opt_sig_ragpb - parameter sweep of the "rag-pb" (RunAwayGap - pullback) signal
// from ETSB_earlyTrendStrongBreakout.pine.
//
// Swept inputs (own group "Signal: RunAwayGap - pullback"):
//   iBullishRagPbMaxTimeSinceRag (int)  in {30,50,60}
//   iBullishRagPbAdrMultiple     (float) in {1.0,1.5,2.0}
//   -> 9 variants (name: ragPb<time>a<adr*10>)
// No shared building blocks are swept (rag-pb does not use strongBreakout).
// Table only, schema v3, designed for scripts/tv_table_scraper.py.
// Sanity check: ragPb50a15 reproduces the original default (50, 1.5).

//@version=6
indicator("perf opt sig ragpb", overlay = true, calc_bars_count = 12 * 252, max_bars_back = 500)

import drebel/DRELib/39 as drelib
import drebel/DREPerf/27 as dreperf

//signal performance check inputs (same defaults as ETSB)
iSigCheckTime = input.int(defval = 30, title = 'Signal check time [candles]', minval = 5, maxval = 200, display = display.none, group = 'Sig. performance check')
iSigStopLossDay = input.int(defval = 2, title = 'Stop loss (day of low)', minval = 0, maxval = 10, display = display.none, group = 'Sig. performance check')
iSigStopLossMaxPct = input.float(defval = 8.0, title = 'Stop loss [pct]', minval = 0.0, maxval = 20.0, step = 0.5, display = display.none, group = 'Sig. performance check')
iMinSigSuccessRate = input.float(defval = 46.0, title = 'Min. sig success rate [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')
iMinSigReturnAdrMultiple = input.float(defval = 1.2, title = 'Min. avg. return by ADR multiple', minval = -1.0, maxval = 5.0, step = 0.05, display = display.none, group = 'Sig. performance check')
iMinSigCount = input.int(defval = 30, title = 'min. signals count', minval = 0, display = display.none, group = 'Sig. performance check')
iMinSigWilsonLb = input.float(defval = 30.0, title = 'min. win-rate lower bound (Wilson) [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')

//common computations
adrPct = 100.0 * (ta.sma(high / low, 100) - 1)
adrCond = iMinSigReturnAdrMultiple * adrPct
float sl = math.max(ta.lowest(iSigStopLossDay + 1), close * (1.0 - iSigStopLossMaxPct / 100.0)) // max loss capped by higher of: current or prev. day low OR max % loss

//shared prerequisites (not swept)
gVolMa = ta.sma(volume, 30)
shortMa = ta.sma(close, 50)

//variant factory; _maxTime = iBullishRagPbMaxTimeSinceRag, _adr = iBullishRagPbAdrMultiple
ragPbCalc(int _maxTime, float _adr) =>
    bool _rag = low > high[1] + _adr * adrPct / 100 * high[1] and volume > gVolMa
    int _ago = ta.barssince(_rag)
    not _rag and _ago < _maxTime and drelib.crossover(low[_ago]) and shortMa > shortMa[1]

//quality metrics wrapper -> [win%, N, avgR, PF, maxDD, score, sumWinR, sumLossR]
q(series bool _sig) =>
    [_sr, _sc, _n, _ar, _sro, _srs, _wr, _wc, _avgR, _medR, _stdR, _pf, _wlb, _mfe, _mae, _dd, _mls, _score, _qok, _swr, _slr] = dreperf.signalQualityFull(_sig, sl, true, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
    [_wr, _n, _avgR, _pf, _dd, _score, _swr, _slr]

//------------------------------------------------------------------------------
//9 variants (maxTime x adrMultiple)
//------------------------------------------------------------------------------
ragPb30a10 = ragPbCalc(30, 1.0)
[ragPb30a10_wr, ragPb30a10_n, ragPb30a10_ar, ragPb30a10_pf, ragPb30a10_dd, ragPb30a10_sc, ragPb30a10_swr, ragPb30a10_slr] = q(ragPb30a10)
ragPb30a15 = ragPbCalc(30, 1.5)
[ragPb30a15_wr, ragPb30a15_n, ragPb30a15_ar, ragPb30a15_pf, ragPb30a15_dd, ragPb30a15_sc, ragPb30a15_swr, ragPb30a15_slr] = q(ragPb30a15)
ragPb30a20 = ragPbCalc(30, 2.0)
[ragPb30a20_wr, ragPb30a20_n, ragPb30a20_ar, ragPb30a20_pf, ragPb30a20_dd, ragPb30a20_sc, ragPb30a20_swr, ragPb30a20_slr] = q(ragPb30a20)
ragPb50a10 = ragPbCalc(50, 1.0)
[ragPb50a10_wr, ragPb50a10_n, ragPb50a10_ar, ragPb50a10_pf, ragPb50a10_dd, ragPb50a10_sc, ragPb50a10_swr, ragPb50a10_slr] = q(ragPb50a10)
ragPb50a15 = ragPbCalc(50, 1.5)
[ragPb50a15_wr, ragPb50a15_n, ragPb50a15_ar, ragPb50a15_pf, ragPb50a15_dd, ragPb50a15_sc, ragPb50a15_swr, ragPb50a15_slr] = q(ragPb50a15)
ragPb50a20 = ragPbCalc(50, 2.0)
[ragPb50a20_wr, ragPb50a20_n, ragPb50a20_ar, ragPb50a20_pf, ragPb50a20_dd, ragPb50a20_sc, ragPb50a20_swr, ragPb50a20_slr] = q(ragPb50a20)
ragPb60a10 = ragPbCalc(60, 1.0)
[ragPb60a10_wr, ragPb60a10_n, ragPb60a10_ar, ragPb60a10_pf, ragPb60a10_dd, ragPb60a10_sc, ragPb60a10_swr, ragPb60a10_slr] = q(ragPb60a10)
ragPb60a15 = ragPbCalc(60, 1.5)
[ragPb60a15_wr, ragPb60a15_n, ragPb60a15_ar, ragPb60a15_pf, ragPb60a15_dd, ragPb60a15_sc, ragPb60a15_swr, ragPb60a15_slr] = q(ragPb60a15)
ragPb60a20 = ragPbCalc(60, 2.0)
[ragPb60a20_wr, ragPb60a20_n, ragPb60a20_ar, ragPb60a20_pf, ragPb60a20_dd, ragPb60a20_sc, ragPb60a20_swr, ragPb60a20_slr] = q(ragPb60a20)

//------------------------------------------------------------------------------
//print sig performance table (schema v3: sig | win% | N | avgR | PF | maxDD | score | winR | lossR)
//------------------------------------------------------------------------------
renderRow(table _tbl, int _row, string _name, float _winRatePct, int _sigCnt, float _avgR, float _pf, float _maxDdR, float _score, float _sumWinR, float _sumLossR) =>
    table.cell(table_id = _tbl, column = 0, row = _row, text = _name, text_size = size.small)
    table.cell(table_id = _tbl, column = 1, row = _row, text = str.tostring(_winRatePct, "#.#"), text_size = size.small)
    table.cell(table_id = _tbl, column = 2, row = _row, text = str.tostring(_sigCnt), text_size = size.small)
    table.cell(table_id = _tbl, column = 3, row = _row, text = str.tostring(_avgR, "#.##"), text_size = size.small)
    table.cell(table_id = _tbl, column = 4, row = _row, text = na(_pf) ? "∞" : str.tostring(_pf, "#.##"), text_size = size.small)
    table.cell(table_id = _tbl, column = 5, row = _row, text = str.tostring(_maxDdR, "#.##"), text_size = size.small)
    table.cell(table_id = _tbl, column = 6, row = _row, text = str.tostring(_score, "#.#"), text_size = size.small)
    table.cell(table_id = _tbl, column = 7, row = _row, text = str.tostring(_sumWinR, "#.#"), text_size = size.small)
    table.cell(table_id = _tbl, column = 8, row = _row, text = str.tostring(_sumLossR, "#.#"), text_size = size.small)

if barstate.islast
    var tbl = table.new(position = position.top_right, columns = 9, rows = 12)
    txtSize = size.small
    table.cell(table_id = tbl, column = 0, row = 2, text = "sig", text_size = txtSize)
    table.cell(table_id = tbl, column = 1, row = 2, text = "win%", text_size = txtSize)
    table.cell(table_id = tbl, column = 2, row = 2, text = "N", text_size = txtSize)
    table.cell(table_id = tbl, column = 3, row = 2, text = "avgR", text_size = txtSize)
    table.cell(table_id = tbl, column = 4, row = 2, text = "PF", text_size = txtSize)
    table.cell(table_id = tbl, column = 5, row = 2, text = "maxDD", text_size = txtSize)
    table.cell(table_id = tbl, column = 6, row = 2, text = "score", text_size = txtSize)
    table.cell(table_id = tbl, column = 7, row = 2, text = "winR", text_size = txtSize)
    table.cell(table_id = tbl, column = 8, row = 2, text = "lossR", text_size = txtSize)

    renderRow(tbl, 3, "ragPb30a10", ragPb30a10_wr, ragPb30a10_n, ragPb30a10_ar, ragPb30a10_pf, ragPb30a10_dd, ragPb30a10_sc, ragPb30a10_swr, ragPb30a10_slr)
    renderRow(tbl, 4, "ragPb30a15", ragPb30a15_wr, ragPb30a15_n, ragPb30a15_ar, ragPb30a15_pf, ragPb30a15_dd, ragPb30a15_sc, ragPb30a15_swr, ragPb30a15_slr)
    renderRow(tbl, 5, "ragPb30a20", ragPb30a20_wr, ragPb30a20_n, ragPb30a20_ar, ragPb30a20_pf, ragPb30a20_dd, ragPb30a20_sc, ragPb30a20_swr, ragPb30a20_slr)
    renderRow(tbl, 6, "ragPb50a10", ragPb50a10_wr, ragPb50a10_n, ragPb50a10_ar, ragPb50a10_pf, ragPb50a10_dd, ragPb50a10_sc, ragPb50a10_swr, ragPb50a10_slr)
    renderRow(tbl, 7, "ragPb50a15", ragPb50a15_wr, ragPb50a15_n, ragPb50a15_ar, ragPb50a15_pf, ragPb50a15_dd, ragPb50a15_sc, ragPb50a15_swr, ragPb50a15_slr)
    renderRow(tbl, 8, "ragPb50a20", ragPb50a20_wr, ragPb50a20_n, ragPb50a20_ar, ragPb50a20_pf, ragPb50a20_dd, ragPb50a20_sc, ragPb50a20_swr, ragPb50a20_slr)
    renderRow(tbl, 9, "ragPb60a10", ragPb60a10_wr, ragPb60a10_n, ragPb60a10_ar, ragPb60a10_pf, ragPb60a10_dd, ragPb60a10_sc, ragPb60a10_swr, ragPb60a10_slr)
    renderRow(tbl, 10, "ragPb60a15", ragPb60a15_wr, ragPb60a15_n, ragPb60a15_ar, ragPb60a15_pf, ragPb60a15_dd, ragPb60a15_sc, ragPb60a15_swr, ragPb60a15_slr)
    renderRow(tbl, 11, "ragPb60a20", ragPb60a20_wr, ragPb60a20_n, ragPb60a20_ar, ragPb60a20_pf, ragPb60a20_dd, ragPb60a20_sc, ragPb60a20_swr, ragPb60a20_slr)
