// Signal for the best version (default to v31/all-on until best is determined)
bestSignal = bestVersionIdx == -1 ? minVwapTAG_31 : bestVersionIdx == 0 ? minVwapTAG_0 : bestVersionIdx == 1 ? minVwapTAG_1 : bestVersionIdx == 2 ? minVwapTAG_2 : bestVersionIdx == 3 ? minVwapTAG_3 : bestVersionIdx == 4 ? minVwapTAG_4 : bestVersionIdx == 5 ? minVwapTAG_5 : bestVersionIdx == 6 ? minVwapTAG_6 : bestVersionIdx == 7 ? minVwapTAG_7 : bestVersionIdx == 8 ? minVwapTAG_8 : bestVersionIdx == 9 ? minVwapTAG_9 : bestVersionIdx == 10 ? minVwapTAG_10 : bestVersionIdx == 11 ? minVwapTAG_11 : bestVersionIdx == 12 ? minVwapTAG_12 : bestVersionIdx == 13 ? minVwapTAG_13 : bestVersionIdx == 14 ? minVwapTAG_14 : bestVersionIdx == 15 ? minVwapTAG_15 : bestVersionIdx == 16 ? minVwapTAG_16 : bestVersionIdx == 17 ? minVwapTAG_17 : bestVersionIdx == 18 ? minVwapTAG_18 : bestVersionIdx == 19 ? minVwapTAG_19 : bestVersionIdx == 20 ? minVwapTAG_20 : bestVersionIdx == 21 ? minVwapTAG_21 : bestVersionIdx == 22 ? minVwapTAG_22 : bestVersionIdx == 23 ? minVwapTAG_23 : bestVersionIdx == 24 ? minVwapTAG_24 : bestVersionIdx == 25 ? minVwapTAG_25 : bestVersionIdx == 26 ? minVwapTAG_26 : bestVersionIdx == 27 ? minVwapTAG_27 : bestVersionIdx == 28 ? minVwapTAG_28 : bestVersionIdx == 29 ? minVwapTAG_29 : bestVersionIdx == 30 ? minVwapTAG_30 : bestVersionIdx == 31 ? minVwapTAG_31 : false

// === VERSION LABEL WITH CLUE (bit pattern OVCFR) ===
verLabel(i) =>
    o = i % 2 == 1
    v = int(i / 2) % 2 == 1
    c = int(i / 4) % 2 == 1
    f = int(i / 8) % 2 == 1
    r = int(i / 16) % 2 == 1
    "v" + str.tostring(i) + "(" + (o ? "1" : "0") + (v ? "1" : "0") + (c ? "1" : "0") + (f ? "1" : "0") + (r ? "1" : "0") + ")"

verLabelBest(i) =>
    i == bestVersionIdx ? verLabel(i) + "*" : verLabel(i)

showRow(_iShowOnlyGoodSigs, sigOk) =>
    _iShowOnlyGoodSigs and sigOk or not _iShowOnlyGoodSigs

// === TABLE OF PERFORMANCE ===
