    if showRow(iShowOnlyGoodSigs, ok31)
        table.cell(table_id = tbl, column = 0, row = 33, text = verLabelBest(31), text_size = txtSize)
        table.cell(table_id = tbl, column = 1, row = 33, text = str31, text_size = txtSize)

