//@version=6
indicator("Riding Vwap Optimizer", overlay = true, calc_bars_count = 12 * 252, max_bars_back = 500)

import drebel/DRELib/39 as drelib
import drebel/DREPerf/24 as dreperf

// === Riding Vwap Inputs ===
iRidingVwapMajorLowLookup = input.int(defval = 150, title = "major low lookup", minval = 50, maxval = 300, display = display.none, group = "Riding Vwap TouchAndGo")
iRidingVwapLowsBelow = input.int(defval = 5, title = "Max. lows below vwap", minval = 1, maxval = 10, display = display.none, group = "Riding Vwap TouchAndGo")
iRidingVwapMaxTouchesPerVwap = input.int(defval = 2, title = 'Max. touches per Vwap', minval = 1, maxval = 5, display = display.none, group = "Riding Vwap TouchAndGo")
iRidingVwapNoTouchCancelThreshold = input.int(defval = 300, title = 'Vwap no touch cancel threshold', minval = 20, maxval = 500, step = 20, display = display.none, group = "Riding Vwap TouchAndGo")
iRidingVwapMinLowestCandle = input.int(defval = 10, title = 'Min. number of candles to check local low', minval = 3, maxval = 20, display = display.none, group = "Riding Vwap TouchAndGo")
iRidingVwapSrc = input.string(defval = "low", title = "VWAP price source", options = ["low", "high", "close", "ohlc4"], display = display.none, group = "Riding Vwap TouchAndGo")

// === RMV contraction inputs (for contraction condition) ===
iContr1RmvMainLookback = input.int(defval = 13, title = 'Contr1 lookbacks (main/s1/s2/s3)', minval = 8, maxval = 200, display = display.none, inline = 'contr1', group = 'Contraction params 1')
iContr1RmvS1Lookback = input.int(defval = 5, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr1', group = 'Contraction params 1')
iContr1RmvS2Lookback = input.int(defval = 3, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr1', group = 'Contraction params 1')
iContr1RmvS3Lookback = input.int(defval = 2, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr1', group = 'Contraction params 1')

iContr2RmvMainLookback = input.int(defval = 21, title = 'Contr2 lookbacks (main/s1/s2/s3)', minval = 10, maxval = 200, display = display.none, inline = 'contr2', group = 'Contraction params 2')
iContr2RmvS1Lookback = input.int(defval = 8, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr2', group = 'Contraction params 2')
iContr2RmvS2Lookback = input.int(defval = 5, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr2', group = 'Contraction params 2')
iContr2RmvS3Lookback = input.int(defval = 3, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr2', group = 'Contraction params 2')

iContr3RmvMainLookback = input.int(defval = 55, title = 'Contr3 lookbacks (main/s1/s2/s3)', minval = 10, maxval = 200, display = display.none, inline = 'contr3', group = 'Contraction params 3')
iContr3RmvS1Lookback = input.int(defval = 34, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr3', group = 'Contraction params 3')
iContr3RmvS2Lookback = input.int(defval = 21, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr3', group = 'Contraction params 3')
iContr3RmvS3Lookback = input.int(defval = 13, title = '', minval = 1, maxval = 50, display = display.none, inline = 'contr3', group = 'Contraction params 3')

iRmvMinVolumeMultiple = input.float(defval = 1.15, title = 'Rmv volume multiple', minval = 0.0, maxval = 3.0, step = 0.05, display = display.none, group = 'Contraction params')

// === Performance & Table Inputs ===
iSigCheckTime = input.int(defval = 30, title = 'Signal check time [candles]', minval = 5, maxval = 200, display = display.none, group = 'Performance')
iSigStopLossDay = input.int(defval = 2, title = 'Stop loss (day of low)', minval = 0, maxval = 10, display = display.none, group = 'Performance')
iSigStopLossMaxPct = input.float(defval = 8.0, title = 'Stop loss [pct]', minval = 0.0, maxval = 20.0, step = 0.5, display = display.none, group = 'Performance')
iMinSigSuccessRate = input.float(defval = 41.0, title = 'Min. sig success rate [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Performance')
iMinSigReturnAdrMultiple = input.float(defval = 0.9, title = 'Min. avg. return by ADR multiple', minval = -1.0, maxval = 5.0, step = 0.05, display = display.none, group = 'Performance')
iShowSigPerfTable = input.bool(defval = true, title = 'Show version perf table', display = display.none, group = 'Performance')
iShowOnlyGoodSigs = input.bool(defval = true, title = 'Show only good versions', display = display.none, group = 'Performance')

// === BASE CALCULATIONS ===
ridingVwapSrc = switch iRidingVwapSrc
    "low"   => low
    "high"  => high
    "close" => close
    "ohlc4" => ohlc4

gVolMa = ta.sma(volume, 30)
mainMa = ta.sma(close, 200)
gVShortMa1 = ta.ema(close, 10)

obvCondRaw = drelib.isAboveObvSmaStddev(100, 0.35)
adrPct = 100.0 * (ta.sma(high / low, 100) - 1)
adrCond = iMinSigReturnAdrMultiple * adrPct

// RMV contractions (needed for contractionAgo)
rmvLowLevel = 25
rmvContraction1 = drelib.rmv(iContr1RmvMainLookback, iContr1RmvS1Lookback, iContr1RmvS2Lookback, iContr1RmvS3Lookback)
lowRmv1 = rmvContraction1 <= rmvLowLevel
rmvContraction2 = drelib.rmv(iContr2RmvMainLookback, iContr2RmvS1Lookback, iContr2RmvS2Lookback, iContr2RmvS3Lookback)
lowRmv2 = rmvContraction2 <= rmvLowLevel
rmvContraction3 = drelib.rmv(iContr3RmvMainLookback, iContr3RmvS1Lookback, iContr3RmvS2Lookback, iContr3RmvS3Lookback)
lowRmv3 = rmvContraction3 <= rmvLowLevel
contractionAgo = ta.barssince(lowRmv1 or lowRmv2 or lowRmv3)

// Riding vwap base (flag-independent mechanics)
loweringMa = ta.barssince(mainMa < mainMa[1])
lowest200 = ta.lowest(iRidingVwapMajorLowLookup)
lowestSinceInception = ta.lowest(math.min(bar_index + 1, 500))
newStockMajorLow = low == lowestSinceInception and bar_index + 1 < iRidingVwapMajorLowLookup and bar_index + 1 > 10
majorLow = (low == lowest200 and loweringMa < 50 and low < mainMa) or newStockMajorLow
majorLVwap = ta.vwap(ridingVwapSrc, majorLow)
majorLowAgo = ta.barssince(majorLow)
majorLowVwap = majorLowAgo > iRidingVwapNoTouchCancelThreshold ? na : majorLVwap
lowsBelowMjVwap = math.sum(low < majorLVwap ? 1 : 0, 10)
lowestRecent = ta.lowest(iRidingVwapMinLowestCandle)

// Base flush condition (flag-independent)
ridngVwapLowFlush = volume > gVolMa and volume > volume[1] or volume > 2 * gVolMa

// Stop loss
float sl = math.max(ta.lowest(iSigStopLossDay + 1), close * (1.0 - iSigStopLossMaxPct / 100.0))

// Constant true series (for when a condition is off)
trueSeries = true

// === CHAIN STEP FUNCTION (stateless - touchCount is parameter, not var) ===
chainStep(series float _pv, series float _src, int _pa, series bool _fc, int _tc) =>
    nw = low < _pv and lowestRecent == low and _pa > 0
    lv = ta.vwap(_src, nw)
    ag = ta.barssince(nw)
    av = ag > _pa or ag > iRidingVwapNoTouchCancelThreshold ? na : lv
    lb = math.sum(low < av ? 1 : 0, 10)
    pt = drelib.crossover(_pv) and lb <= iRidingVwapLowsBelow and _tc <= iRidingVwapMaxTouchesPerVwap and _fc[_pa]
    nt = pt ? _tc + 1 : _tc
    [nw, ag, av, pt, nt]

// === VWAP TOUCH CHAINS (separate for flush ON / flush OFF) ===

// Flush OFF: condition always passes (true)
var int tc2_f0 = 0
var int tc3_f0 = 0
var int tc4_f0 = 0
var int tc5_f0 = 0
[ml1_f0, ma1_f0, mv1_f0, vt2_f0, _t2f0] = chainStep(majorLowVwap, ridingVwapSrc, majorLowAgo, trueSeries, tc2_f0)
tc2_f0 := _t2f0
[ml2_f0, ma2_f0, mv2_f0, vt3_f0, _t3f0] = chainStep(mv1_f0, ridingVwapSrc, math.min(majorLowAgo, ma1_f0), trueSeries, tc3_f0)
tc3_f0 := _t3f0
[ml3_f0, ma3_f0, mv3_f0, vt4_f0, _t4f0] = chainStep(mv2_f0, ridingVwapSrc, math.min(majorLowAgo, ma1_f0, ma2_f0), trueSeries, tc4_f0)
tc4_f0 := _t4f0
[ml4_f0, ma4_f0, mv4_f0, vt5_f0, _t5f0] = chainStep(mv3_f0, ridingVwapSrc, math.min(majorLowAgo, ma1_f0, ma2_f0, ma3_f0), trueSeries, tc5_f0)
tc5_f0 := _t5f0
var int tc6_f0 = 0
var int tc7_f0 = 0
[ml5_f0, ma5_f0, mv5_f0, vt6_f0, _t6f0] = chainStep(mv4_f0, ridingVwapSrc, math.min(majorLowAgo, ma1_f0, ma2_f0, ma3_f0, ma4_f0), trueSeries, tc6_f0)
tc6_f0 := _t6f0
[ml6_f0, ma6_f0, mv6_f0, vt7_f0, _t7f0] = chainStep(mv5_f0, ridingVwapSrc, math.min(majorLowAgo, ma1_f0, ma2_f0, ma3_f0, ma4_f0, ma5_f0), trueSeries, tc7_f0)
tc7_f0 := _t7f0

// Flush ON: uses ridngVwapLowFlush condition
var int tc2_f1 = 0
var int tc3_f1 = 0
var int tc4_f1 = 0
var int tc5_f1 = 0
[ml1_f1, ma1_f1, mv1_f1, vt2_f1, _t2f1] = chainStep(majorLowVwap, ridingVwapSrc, majorLowAgo, ridngVwapLowFlush, tc2_f1)
tc2_f1 := _t2f1
[ml2_f1, ma2_f1, mv2_f1, vt3_f1, _t3f1] = chainStep(mv1_f1, ridingVwapSrc, math.min(majorLowAgo, ma1_f1), ridngVwapLowFlush, tc3_f1)
tc3_f1 := _t3f1
[ml3_f1, ma3_f1, mv3_f1, vt4_f1, _t4f1] = chainStep(mv2_f1, ridingVwapSrc, math.min(majorLowAgo, ma1_f1, ma2_f1), ridngVwapLowFlush, tc4_f1)
tc4_f1 := _t4f1
[ml4_f1, ma4_f1, mv4_f1, vt5_f1, _t5f1] = chainStep(mv3_f1, ridingVwapSrc, math.min(majorLowAgo, ma1_f1, ma2_f1, ma3_f1), ridngVwapLowFlush, tc5_f1)
tc5_f1 := _t5f1
var int tc6_f1 = 0
var int tc7_f1 = 0
[ml5_f1, ma5_f1, mv5_f1, vt6_f1, _t6f1] = chainStep(mv4_f1, ridingVwapSrc, math.min(majorLowAgo, ma1_f1, ma2_f1, ma3_f1, ma4_f1), ridngVwapLowFlush, tc6_f1)
tc6_f1 := _t6f1
[ml6_f1, ma6_f1, mv6_f1, vt7_f1, _t7f1] = chainStep(mv5_f1, ridingVwapSrc, math.min(majorLowAgo, ma1_f1, ma2_f1, ma3_f1, ma4_f1, ma5_f1), ridngVwapLowFlush, tc7_f1)
tc7_f1 := _t7f1

// === VWAP TOUCH (step 1) FOR EACH (VOL, FLUSH) COMBINATION ===
vt_volOff_flushOff = majorLowAgo > 10 and majorLowAgo < iRidingVwapNoTouchCancelThreshold and drelib.crossover(majorLVwap) and lowsBelowMjVwap <= iRidingVwapLowsBelow and trueSeries and trueSeries[majorLowAgo]
vt_volOn_flushOff  = majorLowAgo > 10 and majorLowAgo < iRidingVwapNoTouchCancelThreshold and drelib.crossover(majorLVwap) and lowsBelowMjVwap <= iRidingVwapLowsBelow and (volume > gVolMa) and trueSeries[majorLowAgo]
vt_volOff_flushOn  = majorLowAgo > 10 and majorLowAgo < iRidingVwapNoTouchCancelThreshold and drelib.crossover(majorLVwap) and lowsBelowMjVwap <= iRidingVwapLowsBelow and trueSeries and ridngVwapLowFlush[majorLowAgo]
vt_volOn_flushOn   = majorLowAgo > 10 and majorLowAgo < iRidingVwapNoTouchCancelThreshold and drelib.crossover(majorLVwap) and lowsBelowMjVwap <= iRidingVwapLowsBelow and (volume > gVolMa) and ridngVwapLowFlush[majorLowAgo]

// === HELPER: compute minVwapTAG for a given parameter set ===
minVwapTAG_func(bool o, bool v, bool c, bool f, bool r, series bool vt, series bool vt2, series bool vt3, series bool vt4, series bool vt5, series bool vt6, series bool vt7) =>
    ok = o ? obvCondRaw : true
    vk = v ? (volume > gVolMa) : true
    ck = c ? (contractionAgo <= 2) : true
    rk = r ? (mainMa > mainMa[1]) : true
    (
        ((vt or vt2) and not (vt3 or vt4 or vt5 or vt6 or vt7))
    or ((vt2 or vt3) and not (vt or vt4 or vt5 or vt6 or vt7))
    or ((vt3 or vt4) and not (vt or vt2 or vt5 or vt6 or vt7))
    or ((vt4 or vt5) and not (vt or vt2 or vt3 or vt6 or vt7))
    or ((vt5 or vt6) and not (vt or vt2 or vt3 or vt4 or vt7))
    or ((vt6 or vt7) and not (vt or vt2 or vt3 or vt4 or vt5))
    ) and close >= high[1] and ok and vk and ck and rk

// === HELPER MAPS: select touch signal by flag values ===
vtMap(bool v, bool f) =>
    not v and not f ? vt_volOff_flushOff : v and not f ? vt_volOn_flushOff : not v and f ? vt_volOff_flushOn : vt_volOn_flushOn

vt2Map(bool f) => f ? vt2_f1 : vt2_f0
vt3Map(bool f) => f ? vt3_f1 : vt3_f0
vt4Map(bool f) => f ? vt4_f1 : vt4_f0
vt5Map(bool f) => f ? vt5_f1 : vt5_f0
vt6Map(bool f) => f ? vt6_f1 : vt6_f0
vt7Map(bool f) => f ? vt7_f1 : vt7_f0

// === ASSEMBLE ALL 32 VERSIONS (OVCFR bits) ===
 // bit0=O, bit1=V, bit2=C, bit3=F, bit4=R
b(i, n) => int(i / n) % 2 == 1

minVwapTAG_0  = minVwapTAG_func(b(0,1),  b(0,2),  b(0,4),  b(0,8),  b(0,16),  vtMap(b(0,2), b(0,8)),  vt2Map(b(0,8)),  vt3Map(b(0,8)),  vt4Map(b(0,8)),  vt5Map(b(0,8)),  vt6Map(b(0,8)),  vt7Map(b(0,8)))
minVwapTAG_1  = minVwapTAG_func(b(1,1),  b(1,2),  b(1,4),  b(1,8),  b(1,16),  vtMap(b(1,2), b(1,8)),  vt2Map(b(1,8)),  vt3Map(b(1,8)),  vt4Map(b(1,8)),  vt5Map(b(1,8)),  vt6Map(b(1,8)),  vt7Map(b(1,8)))
minVwapTAG_2  = minVwapTAG_func(b(2,1),  b(2,2),  b(2,4),  b(2,8),  b(2,16),  vtMap(b(2,2), b(2,8)),  vt2Map(b(2,8)),  vt3Map(b(2,8)),  vt4Map(b(2,8)),  vt5Map(b(2,8)),  vt6Map(b(2,8)),  vt7Map(b(2,8)))
minVwapTAG_3  = minVwapTAG_func(b(3,1),  b(3,2),  b(3,4),  b(3,8),  b(3,16),  vtMap(b(3,2), b(3,8)),  vt2Map(b(3,8)),  vt3Map(b(3,8)),  vt4Map(b(3,8)),  vt5Map(b(3,8)),  vt6Map(b(3,8)),  vt7Map(b(3,8)))
minVwapTAG_4  = minVwapTAG_func(b(4,1),  b(4,2),  b(4,4),  b(4,8),  b(4,16),  vtMap(b(4,2), b(4,8)),  vt2Map(b(4,8)),  vt3Map(b(4,8)),  vt4Map(b(4,8)),  vt5Map(b(4,8)),  vt6Map(b(4,8)),  vt7Map(b(4,8)))
minVwapTAG_5  = minVwapTAG_func(b(5,1),  b(5,2),  b(5,4),  b(5,8),  b(5,16),  vtMap(b(5,2), b(5,8)),  vt2Map(b(5,8)),  vt3Map(b(5,8)),  vt4Map(b(5,8)),  vt5Map(b(5,8)),  vt6Map(b(5,8)),  vt7Map(b(5,8)))
minVwapTAG_6  = minVwapTAG_func(b(6,1),  b(6,2),  b(6,4),  b(6,8),  b(6,16),  vtMap(b(6,2), b(6,8)),  vt2Map(b(6,8)),  vt3Map(b(6,8)),  vt4Map(b(6,8)),  vt5Map(b(6,8)),  vt6Map(b(6,8)),  vt7Map(b(6,8)))
minVwapTAG_7  = minVwapTAG_func(b(7,1),  b(7,2),  b(7,4),  b(7,8),  b(7,16),  vtMap(b(7,2), b(7,8)),  vt2Map(b(7,8)),  vt3Map(b(7,8)),  vt4Map(b(7,8)),  vt5Map(b(7,8)),  vt6Map(b(7,8)),  vt7Map(b(7,8)))
minVwapTAG_8  = minVwapTAG_func(b(8,1),  b(8,2),  b(8,4),  b(8,8),  b(8,16),  vtMap(b(8,2), b(8,8)),  vt2Map(b(8,8)),  vt3Map(b(8,8)),  vt4Map(b(8,8)),  vt5Map(b(8,8)),  vt6Map(b(8,8)),  vt7Map(b(8,8)))
minVwapTAG_9  = minVwapTAG_func(b(9,1),  b(9,2),  b(9,4),  b(9,8),  b(9,16),  vtMap(b(9,2), b(9,8)),  vt2Map(b(9,8)),  vt3Map(b(9,8)),  vt4Map(b(9,8)),  vt5Map(b(9,8)),  vt6Map(b(9,8)),  vt7Map(b(9,8)))
minVwapTAG_10 = minVwapTAG_func(b(10,1), b(10,2), b(10,4), b(10,8), b(10,16), vtMap(b(10,2), b(10,8)), vt2Map(b(10,8)), vt3Map(b(10,8)), vt4Map(b(10,8)), vt5Map(b(10,8)), vt6Map(b(10,8)), vt7Map(b(10,8)))
minVwapTAG_11 = minVwapTAG_func(b(11,1), b(11,2), b(11,4), b(11,8), b(11,16), vtMap(b(11,2), b(11,8)), vt2Map(b(11,8)), vt3Map(b(11,8)), vt4Map(b(11,8)), vt5Map(b(11,8)), vt6Map(b(11,8)), vt7Map(b(11,8)))
minVwapTAG_12 = minVwapTAG_func(b(12,1), b(12,2), b(12,4), b(12,8), b(12,16), vtMap(b(12,2), b(12,8)), vt2Map(b(12,8)), vt3Map(b(12,8)), vt4Map(b(12,8)), vt5Map(b(12,8)), vt6Map(b(12,8)), vt7Map(b(12,8)))
minVwapTAG_13 = minVwapTAG_func(b(13,1), b(13,2), b(13,4), b(13,8), b(13,16), vtMap(b(13,2), b(13,8)), vt2Map(b(13,8)), vt3Map(b(13,8)), vt4Map(b(13,8)), vt5Map(b(13,8)), vt6Map(b(13,8)), vt7Map(b(13,8)))
minVwapTAG_14 = minVwapTAG_func(b(14,1), b(14,2), b(14,4), b(14,8), b(14,16), vtMap(b(14,2), b(14,8)), vt2Map(b(14,8)), vt3Map(b(14,8)), vt4Map(b(14,8)), vt5Map(b(14,8)), vt6Map(b(14,8)), vt7Map(b(14,8)))
minVwapTAG_15 = minVwapTAG_func(b(15,1), b(15,2), b(15,4), b(15,8), b(15,16), vtMap(b(15,2), b(15,8)), vt2Map(b(15,8)), vt3Map(b(15,8)), vt4Map(b(15,8)), vt5Map(b(15,8)), vt6Map(b(15,8)), vt7Map(b(15,8)))
minVwapTAG_16 = minVwapTAG_func(b(16,1), b(16,2), b(16,4), b(16,8), b(16,16), vtMap(b(16,2), b(16,8)), vt2Map(b(16,8)), vt3Map(b(16,8)), vt4Map(b(16,8)), vt5Map(b(16,8)), vt6Map(b(16,8)), vt7Map(b(16,8)))
minVwapTAG_17 = minVwapTAG_func(b(17,1), b(17,2), b(17,4), b(17,8), b(17,16), vtMap(b(17,2), b(17,8)), vt2Map(b(17,8)), vt3Map(b(17,8)), vt4Map(b(17,8)), vt5Map(b(17,8)), vt6Map(b(17,8)), vt7Map(b(17,8)))
minVwapTAG_18 = minVwapTAG_func(b(18,1), b(18,2), b(18,4), b(18,8), b(18,16), vtMap(b(18,2), b(18,8)), vt2Map(b(18,8)), vt3Map(b(18,8)), vt4Map(b(18,8)), vt5Map(b(18,8)), vt6Map(b(18,8)), vt7Map(b(18,8)))
minVwapTAG_19 = minVwapTAG_func(b(19,1), b(19,2), b(19,4), b(19,8), b(19,16), vtMap(b(19,2), b(19,8)), vt2Map(b(19,8)), vt3Map(b(19,8)), vt4Map(b(19,8)), vt5Map(b(19,8)), vt6Map(b(19,8)), vt7Map(b(19,8)))
minVwapTAG_20 = minVwapTAG_func(b(20,1), b(20,2), b(20,4), b(20,8), b(20,16), vtMap(b(20,2), b(20,8)), vt2Map(b(20,8)), vt3Map(b(20,8)), vt4Map(b(20,8)), vt5Map(b(20,8)), vt6Map(b(20,8)), vt7Map(b(20,8)))
minVwapTAG_21 = minVwapTAG_func(b(21,1), b(21,2), b(21,4), b(21,8), b(21,16), vtMap(b(21,2), b(21,8)), vt2Map(b(21,8)), vt3Map(b(21,8)), vt4Map(b(21,8)), vt5Map(b(21,8)), vt6Map(b(21,8)), vt7Map(b(21,8)))
minVwapTAG_22 = minVwapTAG_func(b(22,1), b(22,2), b(22,4), b(22,8), b(22,16), vtMap(b(22,2), b(22,8)), vt2Map(b(22,8)), vt3Map(b(22,8)), vt4Map(b(22,8)), vt5Map(b(22,8)), vt6Map(b(22,8)), vt7Map(b(22,8)))
