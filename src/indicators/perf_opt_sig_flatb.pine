[flatB95_5_95_wr, flatB95_5_95_n, flatB95_5_95_ar, flatB95_5_95_pf, flatB95_5_95_dd, flatB95_5_95_sc, flatB95_5_95_swr, flatB95_5_95_slr] = q(flatB95_5_95)
flatB98_2_80 = flatbCalc(98, 2, 80)
[flatB98_2_80_wr, flatB98_2_80_n, flatB98_2_80_ar, flatB98_2_80_pf, flatB98_2_80_dd, flatB98_2_80_sc, flatB98_2_80_swr, flatB98_2_80_slr] = q(flatB98_2_80)
flatB98_2_90 = flatbCalc(98, 2, 90)
[flatB98_2_90_wr, flatB98_2_90_n, flatB98_2_90_ar, flatB98_2_90_pf, flatB98_2_90_dd, flatB98_2_90_sc, flatB98_2_90_swr, flatB98_2_90_slr] = q(flatB98_2_90)
flatB98_2_95 = flatbCalc(98, 2, 95)
[flatB98_2_95_wr, flatB98_2_95_n, flatB98_2_95_ar, flatB98_2_95_pf, flatB98_2_95_dd, flatB98_2_95_sc, flatB98_2_95_swr, flatB98_2_95_slr] = q(flatB98_2_95)
flatB98_3_80 = flatbCalc(98, 3, 80)
[flatB98_3_80_wr, flatB98_3_80_n, flatB98_3_80_ar, flatB98_3_80_pf, flatB98_3_80_dd, flatB98_3_80_sc, flatB98_3_80_swr, flatB98_3_80_slr] = q(flatB98_3_80)
flatB98_3_90 = flatbCalc(98, 3, 90)
[flatB98_3_90_wr, flatB98_3_90_n, flatB98_3_90_ar, flatB98_3_90_pf, flatB98_3_90_dd, flatB98_3_90_sc, flatB98_3_90_swr, flatB98_3_90_slr] = q(flatB98_3_90)
flatB98_3_95 = flatbCalc(98, 3, 95)
[flatB98_3_95_wr, flatB98_3_95_n, flatB98_3_95_ar, flatB98_3_95_pf, flatB98_3_95_dd, flatB98_3_95_sc, flatB98_3_95_swr, flatB98_3_95_slr] = q(flatB98_3_95)
flatB98_5_80 = flatbCalc(98, 5, 80)
[flatB98_5_80_wr, flatB98_5_80_n, flatB98_5_80_ar, flatB98_5_80_pf, flatB98_5_80_dd, flatB98_5_80_sc, flatB98_5_80_swr, flatB98_5_80_slr] = q(flatB98_5_80)
flatB98_5_90 = flatbCalc(98, 5, 90)
