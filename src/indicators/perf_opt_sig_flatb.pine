    renderRow(tbl, 18, "flatB98_5_80", flatB98_5_80_wr, flatB98_5_80_n, flatB98_5_80_ar, flatB98_5_80_pf, flatB98_5_80_dd, flatB98_5_80_sc, flatB98_5_80_swr, flatB98_5_80_slr)
