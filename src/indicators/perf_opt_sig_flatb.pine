// perf_opt_sig_flatb - sweep of the "FlatB" (Flat Breakout) signal.
// Swept inputs (own group "Signal: Flat Breakout"):
//   iFlatBreakoutMinRecentPercentile {95,98,100} x iFlatBreakoutClosesJumped {2,3,5} x iFlatBreakoutMaxPercentileOverSMA200 {80,90,95}
//   -> 27 variants. iInitialMinVolumePct kept at default (600). Sanity check: flatB100_3_90 == original default.

//@version=6
indicator("perf opt sig flatb", overlay = true, calc_bars_count = 12 * 252, max_bars_back = 500)

import drebel/DRELib/39 as drelib
import drebel/DREPerf/27 as dreperf

//signal performance check inputs (same defaults as ETSB)
iSigCheckTime = input.int(defval = 30, title = 'Signal check time [candles]', minval = 5, maxval = 200, display = display.none, group = 'Sig. performance check')
iSigStopLossDay = input.int(defval = 2, title = 'Stop loss (day of low)', minval = 0, maxval = 10, display = display.none, group = 'Sig. performance check')
iSigStopLossMaxPct = input.float(defval = 8.0, title = 'Stop loss [pct]', minval = 0.0, maxval = 20.0, step = 0.5, display = display.none, group = 'Sig. performance check')
iMinSigSuccessRate = input.float(defval = 46.0, title = 'Min. sig success rate [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')
iMinSigReturnAdrMultiple = input.float(defval = 1.2, title = 'Min. avg. return by ADR multiple', minval = -1.0, maxval = 5.0, step = 0.05, display = display.none, group = 'Sig. performance check')
iMinSigCount = input.int(defval = 30, title = 'min. signals count', minval = 0, display = display.none, group = 'Sig. performance check')
iMinSigWilsonLb = input.float(defval = 30.0, title = 'min. win-rate lower bound (Wilson) [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')

//common computations
adrPct = 100.0 * (ta.sma(high / low, 100) - 1)
adrCond = iMinSigReturnAdrMultiple * adrPct
float sl = math.max(ta.lowest(iSigStopLossDay + 1), close * (1.0 - iSigStopLossMaxPct / 100.0)) // max loss capped by higher of: current or prev. day low OR max % loss

//shared prerequisites (ETSB defaults, NOT swept)
gVolMa = ta.sma(volume, 30)
mainMa = ta.sma(close, 200)
var int FBLookback = 200
fBPercentRank = ta.percentrank(close, FBLookback)
dttTime = drelib.dttTimePct()
dttVol = volume / gVolMa
dttVolTimePct = 100 * dttVol / dttTime
dayEndMinVolumePct = 145
dttInitialMinVolumePct = 600
timeSinceSessionOpenAdditionalVolPct = math.pow(1 - dttTime, 5) * (dttInitialMinVolumePct - dayEndMinVolumePct)
initialFlat = 0.01
volumeGood = (dttTime >= initialFlat ? (dttVolTimePct > dayEndMinVolumePct + timeSinceSessionOpenAdditionalVolPct) : volume > initialFlat * dttInitialMinVolumePct * gVolMa) or volume > dayEndMinVolumePct * gVolMa
fbHighest = ta.highest(close, FBLookback)
fbPercentileOverSma200 = ta.percentrank((close - mainMa) / mainMa, 200)

//variant factory; _minRecentPct = iFlatBreakoutMinRecentPercentile, _closesJumped = iFlatBreakoutClosesJumped, _maxPctOverSma = iFlatBreakoutMaxPercentileOverSMA200
flatbCalc(int _minRecentPct, int _closesJumped, int _maxPctOverSma) =>
    bool _rankCond = fBPercentRank == _minRecentPct and fBPercentRank[1] <= (_minRecentPct - _closesJumped)
    bool _overSmaCond = fbPercentileOverSma200[1] < _maxPctOverSma
    _rankCond and fbHighest[1] == fbHighest[6] and volumeGood and _overSmaCond

//quality metrics wrapper -> [win%, N, avgR, PF, maxDD, score, sumWinR, sumLossR]
q(series bool _sig) =>
    [_sr, _sc, _n, _ar, _sro, _srs, _wr, _wc, _avgR, _medR, _stdR, _pf, _wlb, _mfe, _mae, _dd, _mls, _score, _qok, _swr, _slr] = dreperf.signalQualityFull(_sig, sl, true, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
    [_wr, _n, _avgR, _pf, _dd, _score, _swr, _slr]

//------------------------------------------------------------------------------
//27 variants
//------------------------------------------------------------------------------
flatB95_2_80 = flatbCalc(95, 2, 80)
[flatB95_2_80_wr, flatB95_2_80_n, flatB95_2_80_ar, flatB95_2_80_pf, flatB95_2_80_dd, flatB95_2_80_sc, flatB95_2_80_swr, flatB95_2_80_slr] = q(flatB95_2_80)
flatB95_2_90 = flatbCalc(95, 2, 90)
[flatB95_2_90_wr, flatB95_2_90_n, flatB95_2_90_ar, flatB95_2_90_pf, flatB95_2_90_dd, flatB95_2_90_sc, flatB95_2_90_swr, flatB95_2_90_slr] = q(flatB95_2_90)
flatB95_2_95 = flatbCalc(95, 2, 95)
[flatB95_2_95_wr, flatB95_2_95_n, flatB95_2_95_ar, flatB95_2_95_pf, flatB95_2_95_dd, flatB95_2_95_sc, flatB95_2_95_swr, flatB95_2_95_slr] = q(flatB95_2_95)
flatB95_3_80 = flatbCalc(95, 3, 80)
