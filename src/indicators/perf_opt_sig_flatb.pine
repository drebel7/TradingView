flatB95_3_95 = flatbCalc(95, 3, 95)
[flatB95_3_95_wr, flatB95_3_95_n, flatB95_3_95_ar, flatB95_3_95_pf, flatB95_3_95_dd, flatB95_3_95_sc, flatB95_3_95_swr, flatB95_3_95_slr] = q(flatB95_3_95)
flatB95_5_80 = flatbCalc(95, 5, 80)
[flatB95_5_80_wr, flatB95_5_80_n, flatB95_5_80_ar, flatB95_5_80_pf, flatB95_5_80_dd, flatB95_5_80_sc, flatB95_5_80_swr, flatB95_5_80_slr] = q(flatB95_5_80)
flatB95_5_90 = flatbCalc(95, 5, 90)
[flatB95_5_90_wr, flatB95_5_90_n, flatB95_5_90_ar, flatB95_5_90_pf, flatB95_5_90_dd, flatB95_5_90_sc, flatB95_5_90_swr, flatB95_5_90_slr] = q(flatB95_5_90)
