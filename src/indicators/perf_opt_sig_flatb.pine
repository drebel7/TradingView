    renderRow(tbl, 20, "flatB98_5_95", flatB98_5_95_wr, flatB98_5_95_n, flatB98_5_95_ar, flatB98_5_95_pf, flatB98_5_95_dd, flatB98_5_95_sc, flatB98_5_95_swr, flatB98_5_95_slr)
    renderRow(tbl, 21, "flatB100_2_80", flatB100_2_80_wr, flatB100_2_80_n, flatB100_2_80_ar, flatB100_2_80_pf, flatB100_2_80_dd, flatB100_2_80_sc, flatB100_2_80_swr, flatB100_2_80_slr)
    renderRow(tbl, 22, "flatB100_2_90", flatB100_2_90_wr, flatB100_2_90_n, flatB100_2_90_ar, flatB100_2_90_pf, flatB100_2_90_dd, flatB100_2_90_sc, flatB100_2_90_swr, flatB100_2_90_slr)
