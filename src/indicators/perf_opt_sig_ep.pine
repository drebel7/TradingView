[c09_v15_b20_greenOff_wr, c09_v15_b20_greenOff_n, c09_v15_b20_greenOff_ar, c09_v15_b20_greenOff_pf, c09_v15_b20_greenOff_dd, c09_v15_b20_greenOff_sc, c09_v15_b20_greenOff_swr, c09_v15_b20_greenOff_slr] = q(c09_v15_b20_greenOff)

