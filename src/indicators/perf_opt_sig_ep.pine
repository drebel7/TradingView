[c09v15b100_nofill_greenOff_g8_wr, c09v15b100_nofill_greenOff_g8_n, c09v15b100_nofill_greenOff_g8_ar, c09v15b100_nofill_greenOff_g8_pf, c09v15b100_nofill_greenOff_g8_dd, c09v15b100_nofill_greenOff_g8_sc, c09v15b100_nofill_greenOff_g8_swr, c09v15b100_nofill_greenOff_g8_slr] = q(c09v15b100_nofill_greenOff_g8)

