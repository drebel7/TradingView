[c09v15b100_nofill_greenOff_v175_wr, c09v15b100_nofill_greenOff_v175_n, c09v15b100_nofill_greenOff_v175_ar, c09v15b100_nofill_greenOff_v175_pf, c09v15b100_nofill_greenOff_v175_dd, c09v15b100_nofill_greenOff_v175_sc, c09v15b100_nofill_greenOff_v175_swr, c09v15b100_nofill_greenOff_v175_slr] = q(c09v15b100_nofill_greenOff_v175)

