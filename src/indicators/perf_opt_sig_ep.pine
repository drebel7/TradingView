//calc_bars_count = 3024 (12 years of 252 bars/year) - no need for more

// perf_opt_sig_ep - Qullamaggie Episodic Pivot (EP) sweep.
//
// Definition (yt/docs/trading/Qullamaggie/qullamaggie-3-timeless-setups.md + Qullamaggie-strategia.md):
//   EP = unexpected good news (earnings/guidance, FDA, contract, theme) -> gap up >= 10% (minimum
//   7-8%) on huge volume (4x average or record), preferably out of a multi-month base and not in a
//   downtrend. Q buys the opening-range high of the first 5-min candle, stop at low of day.
//   Daily proxy used here: signal at the close of the gap day, stop at the day's low (capped at 8%),
//   30-bar DREPerf check. The gap day must close green and in the upper part of its range.
//
// Canonical row "ep": gap >= 10%, volume >= 4x SMA50, close in upper half, close above the prior
// 50-day high, above SMA50 and SMA200, SMA50 rising.
//
// The 30 rows sweep the gap threshold, volume multiple, close location, base lookback, MA filters,
// RS vs benchmark, market/sector regime, ADR, price, dollar volume, 52-week high, gap-above-base,
// green close, max gap and body size.

//@version=6
indicator("EP Qullamaggie (perf sweep)", overlay = true, calc_bars_count = 12 * 252, max_bars_back = 500)

import drebel/DRELib/39 as drelib
import drebel/DREPerf/27 as dreperf

iSigCheckTime = input.int(defval = 30, title = 'Signal check time [candles]', minval = 5, maxval = 200, display = display.none, group = 'Sig. performance check')
iSigStopLossMaxPct = input.float(defval = 8.0, title = 'Stop loss [pct]', minval = 0.0, maxval = 20.0, step = 0.5, display = display.none, group = 'Sig. performance check')
iMinSigSuccessRate = input.float(defval = 46.0, title = 'Min. sig success rate [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')
iMinSigReturnAdrMultiple = input.float(defval = 1.2, title = 'Min. avg. return by ADR multiple', minval = -1.0, maxval = 5.0, step = 0.05, display = display.none, group = 'Sig. performance check')
iMinSigCount = input.int(defval = 30, title = 'min. signals count', minval = 0, display = display.none, group = 'Sig. performance check')
iMinSigWilsonLb = input.float(defval = 30.0, title = 'min. win-rate lower bound (Wilson) [pct]', minval = 0.0, maxval = 100.0, step = 1.0, display = display.none, group = 'Sig. performance check')

adrPct = 100.0 * (ta.sma(high / low, 100) - 1)
adrCond = iMinSigReturnAdrMultiple * adrPct
adr20 = 100.0 * ta.sma((high - low) / close[1], 20)
sma10 = ta.sma(close, 10)
sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
volMa50 = ta.sma(volume, 50)
dollarVol20 = ta.sma(close * volume, 20) / 1000000.0
float sl = math.max(low, close * (1.0 - iSigStopLossMaxPct / 100.0))
hi52wLevel = ta.highest(high, 252)[1]
baseRange20Adr = adr20 > 0 ? 100.0 * (ta.highest(high, 20)[1] - ta.lowest(low, 20)[1]) / close[1] / adr20 : na
hi52wProx = hi52wLevel > 0 ? close / hi52wLevel : na
epsAct = request.earnings(syminfo.tickerid, earnings.actual)
epsUp = not na(epsAct) and not na(epsAct[1]) and epsAct != epsAct[1] and epsAct > epsAct[1]
higherLows20 = ta.lowest(low, 10)[1] > ta.lowest(low, 10)[11]
benchBearish = drelib.defaultBenchmarkMasBearishAligned()
baseHigh20 = ta.highest(high, 20)[1]
baseHigh50 = ta.highest(high, 50)[1]
baseHigh100 = ta.highest(high, 100)[1]
baseHigh200 = ta.highest(high, 200)[1]

benchClose = drelib.getDefaultBenchmarkClose()
rs = close / benchClose
rsMa = ta.sma(rs, 100)
rs1YHigh = rs == ta.highest(rs, 252)
rsHighLately = ta.barssince(rs1YHigh) < 20

epCalc(int _gapMin, float _maxGap, float _volMin, float _closeLocMin, int _baseLookback, bool _baseBreak, bool _above50, bool _above200, bool _sma50Rise, int _rsMode, float _minAdr, float _minPrice, float _minDollarVolM, bool _require52w, bool _gapAbovePriorHigh, bool _requireGreen, float _minBody, bool _requireNoFill, float _minGapAdr, float _maxBaseRangeAdr, float _min52wProx, bool _requireEpsUp, bool _requireHigherLows, bool _requireRegime) =>
    float _gapPct = 100.0 * (open - close[1]) / close[1]
    float _barRange = high - low
    float _closeLoc = _barRange > 0 ? (close - low) / _barRange : 0.0
    float _bodyPct = open > 0 ? 100.0 * (close - open) / open : 0.0
    float _volRatio = volMa50 > 0 ? volume / volMa50 : 0.0
    float _baseHigh = _baseLookback == 20 ? baseHigh20 : _baseLookback == 100 ? baseHigh100 : _baseLookback == 200 ? baseHigh200 : baseHigh50
    bool _gapOk = _gapPct >= _gapMin and (_maxGap >= 100 or _gapPct <= _maxGap)
    bool _volOk = _volRatio >= _volMin
    bool _closeOk = _closeLoc >= _closeLocMin
    bool _baseOk = not _baseBreak or (not na(_baseHigh) and close > _baseHigh)
    bool _gapAboveOk = not _gapAbovePriorHigh or (not na(_baseHigh) and open > _baseHigh)
    bool _ma50Ok = not _above50 or close > sma50
    bool _ma200Ok = not _above200 or close > sma200
    bool _sma50RiseOk = not _sma50Rise or sma50 > sma50[5]
    bool _rsOk = _rsMode == 0 or (_rsMode == 1 and rs > rsMa) or (_rsMode == 2 and rsHighLately)
    bool _adrOk = _minAdr <= 0 or adr20 >= _minAdr
    bool _priceOk = _minPrice <= 0 or close >= _minPrice
    bool _dvOk = _minDollarVolM <= 0 or dollarVol20 >= _minDollarVolM
    bool _hiOk = not _require52w or close > hi52wLevel
    bool _greenOk = not _requireGreen or close > open
    bool _bodyOk = _bodyPct >= _minBody
    bool _noFillOk = not _requireNoFill or low > close[1]
    bool _gapAdrOk = _minGapAdr <= 0 or _gapPct >= _minGapAdr * adr20
    bool _brOk = _maxBaseRangeAdr <= 0 or (not na(baseRange20Adr) and baseRange20Adr <= _maxBaseRangeAdr)
    bool _proxOk = _min52wProx <= 0 or (not na(hi52wProx) and hi52wProx >= _min52wProx)
    bool _epsOk = not _requireEpsUp or epsUp
    bool _hlOk = not _requireHigherLows or higherLows20
    bool _regimeOk = not _requireRegime or not benchBearish
    _gapOk and _volOk and _closeOk and _baseOk and _gapAboveOk and _ma50Ok and _ma200Ok and _sma50RiseOk and _rsOk and _adrOk and _priceOk and _dvOk and _hiOk and _greenOk and _bodyOk and _noFillOk and _gapAdrOk and _brOk and _proxOk and _epsOk and _hlOk and _regimeOk

q(series bool _sig) =>
    [_sr, _sc, _n, _ar, _sro, _srs, _wr, _wc, _avgR, _medR, _stdR, _pf, _wlb, _mfe, _mae, _dd, _mls, _score, _qok, _swr, _slr] = dreperf.signalQualityFull(_sig, sl, true, iMinSigSuccessRate, adrCond, iSigCheckTime, iMinSigCount, iMinSigWilsonLb)
    [_wr, _n, _avgR, _pf, _dd, _score, _swr, _slr]

//------------------------------------------------------------------------------
//iteration 8 - 30 EP variants (final robustness sweep around the qualifying cores) (canonical row "ep" first)
// epCalc(gapMin%, maxGap%, volMin, closeLoc, baseLookback, baseBreak, above50,
//        above200, sma50Rise, rsMode, regimeMin, minAdr, minPrice, minDollarVolM,
//        require52w, gapAbovePriorHigh, requireGreen, minBody%)
//------------------------------------------------------------------------------
ep = epCalc(10, 100.0, 4.0, 0.50, 50, true, true, true, true, 0, 0.0, 0.0, 0.0, false, false, true, 0.0, false, 0.0, 0.0, 0.00, false, false, false)
[ep_wr, ep_n, ep_ar, ep_pf, ep_dd, ep_sc, ep_swr, ep_slr] = q(ep)

c09v15b100_nofill_greenOff = epCalc(10, 100.0, 1.5, 0.90, 100, true, true, true, true, 0, 0.0, 0.0, 0.0, false, false, false, 0.0, true, 0.0, 0.0, 0.00, false, false, false)
[c09v15b100_nofill_greenOff_wr, c09v15b100_nofill_greenOff_n, c09v15b100_nofill_greenOff_ar, c09v15b100_nofill_greenOff_pf, c09v15b100_nofill_greenOff_dd, c09v15b100_nofill_greenOff_sc, c09v15b100_nofill_greenOff_swr, c09v15b100_nofill_greenOff_slr] = q(c09v15b100_nofill_greenOff)

c09_v15_b100 = epCalc(10, 100.0, 1.5, 0.90, 100, true, true, true, true, 0, 0.0, 0.0, 0.0, false, false, true, 0.0, false, 0.0, 0.0, 0.00, false, false, false)
[c09_v15_b100_wr, c09_v15_b100_n, c09_v15_b100_ar, c09_v15_b100_pf, c09_v15_b100_dd, c09_v15_b100_sc, c09_v15_b100_swr, c09_v15_b100_slr] = q(c09_v15_b100)

