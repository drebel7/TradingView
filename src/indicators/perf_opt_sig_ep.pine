[c09v15b100_nofill_greenOff_c88_wr, c09v15b100_nofill_greenOff_c88_n, c09v15b100_nofill_greenOff_c88_ar, c09v15b100_nofill_greenOff_c88_pf, c09v15b100_nofill_greenOff_c88_dd, c09v15b100_nofill_greenOff_c88_sc, c09v15b100_nofill_greenOff_c88_swr, c09v15b100_nofill_greenOff_c88_slr] = q(c09v15b100_nofill_greenOff_c88)

