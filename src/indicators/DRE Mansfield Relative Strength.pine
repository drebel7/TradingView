//@version=5

// Use this indicator to compare how security is performing in compare with prefered index (SPX by default). 
// > 0 outperforming 
// < 0 underperforming
// Works best for weekly, but can be applied to monthly and daily charts. It will be rather useless to use it in smaller timeframes
// Apply it to SPX, industry index, sector index or other security in similar sector

indicator('Mansfield Relative Strength indicator')

index = input.symbol(title='Index', defval='GPW:FW201!')
ma_type = input.string(title='Which moving average to use?', defval='SMA', options=['SMA', 'WMA', 'EMA'])
len = input(title='MA length for Daily', defval=200)

ma_func(x, length) =>
    wma_1 = ta.wma(x, length)
    sma_1 = ta.sma(x, length)
    ema_1 = ta.ema(x, length)
    ma_type == 'WMA' ? wma_1 : ma_type == 'SMA' ? sma_1 : ema_1


calc_mrs_func(x, ind, length) =>
    (x / request.security(ind, timeframe.period, x) / ma_func(x / request.security(ind, timeframe.period, x), length) - 1) * 10


mrs_index = calc_mrs_func(close, index, len)
c = math.sign(mrs_index)

color_1 = color.new(color.green, 80)
color_6 = color.new(color.red, 80)
bgcolor(c == 1 ? color_1 : c == -1 ? color_6 : c == 0 ?  color_6 : color.gray, transp=90)
plot(mrs_index, linewidth=3, title='MRS index')
hline(price=0, linestyle=hline.style_dashed, title='Zero baseline')

