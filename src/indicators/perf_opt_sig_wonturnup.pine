[wtUp45_3_r05_wr, wtUp45_3_r05_n, wtUp45_3_r05_ar, wtUp45_3_r05_pf, wtUp45_3_r05_dd, wtUp45_3_r05_sc, wtUp45_3_r05_swr, wtUp45_3_r05_slr] = q(wtUp45_3_r05)
wtUp45_3_r10 = wonTurnUpCalc(45, 3, 1.0)
