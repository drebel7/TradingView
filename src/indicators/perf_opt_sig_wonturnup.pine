[wtUp45_3_r0_wr, wtUp45_3_r0_n, wtUp45_3_r0_ar, wtUp45_3_r0_pf, wtUp45_3_r0_dd, wtUp45_3_r0_sc, wtUp45_3_r0_swr, wtUp45_3_r0_slr] = q(wtUp45_3_r0)
