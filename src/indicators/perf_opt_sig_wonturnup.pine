    renderRow(tbl, 16, "wtUp45_3_r05", wtUp45_3_r05_wr, wtUp45_3_r05_n, wtUp45_3_r05_ar, wtUp45_3_r05_pf, wtUp45_3_r05_dd, wtUp45_3_r05_sc, wtUp45_3_r05_swr, wtUp45_3_r05_slr)
    renderRow(tbl, 17, "wtUp45_3_r10", wtUp45_3_r10_wr, wtUp45_3_r10_n, wtUp45_3_r10_ar, wtUp45_3_r10_pf, wtUp45_3_r10_dd, wtUp45_3_r10_sc, wtUp45_3_r10_swr, wtUp45_3_r10_slr)
    renderRow(tbl, 18, "wtUp45_4_r0", wtUp45_4_r0_wr, wtUp45_4_r0_n, wtUp45_4_r0_ar, wtUp45_4_r0_pf, wtUp45_4_r0_dd, wtUp45_4_r0_sc, wtUp45_4_r0_swr, wtUp45_4_r0_slr)
    renderRow(tbl, 19, "wtUp45_4_r05", wtUp45_4_r05_wr, wtUp45_4_r05_n, wtUp45_4_r05_ar, wtUp45_4_r05_pf, wtUp45_4_r05_dd, wtUp45_4_r05_sc, wtUp45_4_r05_swr, wtUp45_4_r05_slr)
    renderRow(tbl, 20, "wtUp45_4_r10", wtUp45_4_r10_wr, wtUp45_4_r10_n, wtUp45_4_r10_ar, wtUp45_4_r10_pf, wtUp45_4_r10_dd, wtUp45_4_r10_sc, wtUp45_4_r10_swr, wtUp45_4_r10_slr)
    renderRow(tbl, 21, "wtUp60_2_r0", wtUp60_2_r0_wr, wtUp60_2_r0_n, wtUp60_2_r0_ar, wtUp60_2_r0_pf, wtUp60_2_r0_dd, wtUp60_2_r0_sc, wtUp60_2_r0_swr, wtUp60_2_r0_slr)
