    renderRow(tbl, 23, "wtUp60_2_r10", wtUp60_2_r10_wr, wtUp60_2_r10_n, wtUp60_2_r10_ar, wtUp60_2_r10_pf, wtUp60_2_r10_dd, wtUp60_2_r10_sc, wtUp60_2_r10_swr, wtUp60_2_r10_slr)
    renderRow(tbl, 24, "wtUp60_3_r0", wtUp60_3_r0_wr, wtUp60_3_r0_n, wtUp60_3_r0_ar, wtUp60_3_r0_pf, wtUp60_3_r0_dd, wtUp60_3_r0_sc, wtUp60_3_r0_swr, wtUp60_3_r0_slr)
