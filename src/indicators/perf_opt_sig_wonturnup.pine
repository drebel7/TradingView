    renderRow(tbl, 9, "wtUp30_4_r0", wtUp30_4_r0_wr, wtUp30_4_r0_n, wtUp30_4_r0_ar, wtUp30_4_r0_pf, wtUp30_4_r0_dd, wtUp30_4_r0_sc, wtUp30_4_r0_swr, wtUp30_4_r0_slr)
